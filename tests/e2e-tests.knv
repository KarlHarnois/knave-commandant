(use lib ->argument-spec ->early-exit ->usage-failure
         argument-text cli-error error->message
         matched-value option-value output-stream parse-line
         presence repetition spec->help stop-reason
         switch-state)

(use support/fixture environment-with no-environment
                     no-words serve-spec site-spec
                     spec-with-arguments spec-with-lists
                     spec-with-token words)

(defn line (spec environment texts)
  (parse-line (ref spec)
              (ref environment)
              (ref (words texts))))

(defn serve-line (texts)
  (line (serve-spec) (no-environment) texts))

(defn option-in (parsed long)
  (match parsed
    ((ok found)
     (map-some (option-value (ref found) long) clone))
    ((err _) none)))

(defn option-after (texts long)
  (option-in (serve-line texts) long))

(defn port-with (environment texts)
  (option-in (line (serve-spec) environment texts) "port"))

(defn root-after (texts)
  (match (serve-line texts)
    ((ok found)
     (map-some (argument-text (ref found) "root") clone))
    ((err _) none)))

(defn port-text (text)
  (some (matched-value/one (some (str text)))))

(defn answer (text reason)
  (->early-exit :text text
                :stream output-stream/standard-output
                :code 0
                :reason reason))

(defn refusal (text failure)
  (->early-exit :text text
                :stream output-stream/standard-error
                :code 2
                :reason (stop-reason/usage (->usage-failure :path (vec)
                                                            :error failure))))

(defn kind-of (parsed)
  (match parsed
    ((ok _) "value")
    ((err stop) (reason-kind (:reason stop)))))

(defn reason-kind (reason)
  (match reason
    ((stop-reason/help _) "help")
    ((stop-reason/version _) "version")
    (stop-reason/completion "completion")
    ((stop-reason/usage _) "usage")
    ((stop-reason/broken-spec _) "broken spec")))

(defn own-sentence (parsed)
  (match parsed
    ((err stop) (usage-sentence (:reason stop)))
    ((ok _) (str))))

(defn usage-sentence (reason)
  (match reason
    ((stop-reason/usage failure)
     (str "usage: "
          (error->message (ref (:error failure)))))
    (_ (str))))

(defn report-of (spec texts)
  (match (line spec (no-environment) texts)
    ((ok _) (str))
    ((err stop) (clone (:text stop)))))

(defn report-after (texts)
  (report-of (serve-spec) texts))

(defn site-report (texts)
  (report-of (site-spec) texts))

(deftest every-command-takes-short-and-long-help
  (assert (= (serve-line (vec "serve-me" "-h"))
             (err (answer (spec->help (ref (serve-spec)) 80)
                          (stop-reason/help (vec))))))
  (assert (= (serve-line (vec "--help"))
             (err (answer (spec->help (ref (serve-spec)) 80)
                          (stop-reason/help (vec)))))))

(deftest a-versioned-command-takes-short-and-long-version
  (assert (= (serve-line (vec "-V"))
             (err (answer (str "serve 1.0.0")
                          (stop-reason/version (str "1.0.0"))))))
  (assert (= (serve-line (vec "--version"))
             (err (answer (str "serve 1.0.0")
                          (stop-reason/version (str "1.0.0")))))))

(deftest a-value-is-written-four-ways
  (assert (= (option-after (vec "--port" "80") "port")
             (port-text "80")))
  (assert (= (option-after (vec "--port=80") "port")
             (port-text "80")))
  (assert (= (option-after (vec "-p" "80") "port")
             (port-text "80")))
  (assert (= (option-after (vec "-p80") "port")
             (port-text "80"))))

(deftest short-flags-bundle-before-a-value
  (assert (= (option-after (vec "-vvp80") "verbose")
             (some (matched-value/count 2))))
  (assert (= (option-after (vec "-vvp80") "port")
             (port-text "80"))))

(deftest options-and-arguments-mix-in-any-order
  (assert (= (root-after (vec "--open" "site" "-p" "80"))
             (some (str "site"))))
  (assert (= (option-after (vec "site" "-p" "80") "port")
             (port-text "80"))))

(deftest a-double-dash-ends-the-options
  (assert (= (root-after (vec "--" "--open"))
             (some (str "--open")))))

(deftest a-double-dash-cannot-be-an-option-value
  (assert (starts-with? (as-str (report-after (vec "--port" "--" "80")))
                        "error: option `--port` needs a value")))

(deftest a-negative-number-is-an-argument
  (assert (= (root-after (vec "-5"))
             (some (str "-5")))))

(deftest a-negation-turns-a-switch-off
  (assert (= (option-after (vec "--no-color") "color")
             (some (matched-value/switch switch-state/off)))))

(deftest a-flag-beats-the-environment-which-beats-the-default
  (assert (= (port-with (environment-with "PORT" "90") (vec "-p" "80"))
             (port-text "80")))
  (assert (= (port-with (environment-with "PORT" "90") (no-words))
             (port-text "90")))
  (assert (= (option-after (no-words) "port")
             (port-text "8000"))))

(deftest a-mistyped-option-is-a-usage-error
  (assert (= (serve-line (vec "--prot" "80"))
             (err (refusal (str "error: unknown option `--prot`\n\n"
                                "  tip: a similar option exists: `--port`\n\n"
                                "Usage: serve [OPTIONS] [ROOT]\n\n"
                                "For more information, try `serve --help`.")
                           (cli-error/unknown-option (str "--prot")))))))

(deftest a-mistyped-option-reports-the-closest-option
  (assert (starts-with? (as-str (report-after (vec "--prot" "80")))
                        "error: unknown option `--prot`\n\n  tip: a similar option exists: `--port`")))

(deftest the-help-page-lists-every-option-and-the-builtins
  (assert (= (count (lines (as-str (spec->help (ref (serve-spec)) 80))))
             16)))

(deftest a-global-option-works-after-the-command
  (assert (= (option-in (line (site-spec)
                              (no-environment)
                              (vec "build" "-v" "site"))
                        "verbose")
             (some (matched-value/count 1)))))

(deftest a-mistyped-command-reports-the-closest-command
  (assert (starts-with? (as-str (site-report (vec "pgae")))
                        "error: unknown command `pgae`\n\n  tip: a similar command exists: `page`")))

(deftest a-group-without-a-command-reports-its-own-help
  (assert (= (site-report (vec "page"))
             (str "Manages the pages.\n\n"
                  "Usage: site page [OPTIONS] <COMMAND>\n\n"
                  "Commands:\n"
                  "  add               Adds a page.\n"
                  "  list              Lists the pages.\n"
                  "  help              Print the help of a command\n\n"
                  "Options:\n"
                  "  -v, --verbose...  Logs more\n"
                  "  -h, --help        Print help"))))

(deftest a-missing-required-option-reports-the-usage-that-names-it
  (assert (= (report-of (spec-with-token) (no-words))
             (str "error: option `--token` is required\n\n"
                  "Usage: deploy [OPTIONS] --token <TOKEN>\n\n"
                  "For more information, try `deploy --help`."))))

(deftest a-delimited-list-option-reads-every-part
  (assert (= (option-in (line (spec-with-lists)
                              (no-environment)
                              (vec "--after" "1,2" "--after" "3"))
                        "after")
             (some (matched-value/many (vec (str "1") (str "2") (str "3")))))))

(deftest conflicting-options-report-both-names
  (assert (= (report-of (spec-with-lists)
                        (vec "--description" "x" "--description-file" "y.md"))
             (str "error: option `--description` cannot be used with `--description-file`\n\n"
                  "Usage: add [OPTIONS]\n\n"
                  "For more information, try `add --help`."))))

(defn spec-with-value-name ()
  (spec-with-arguments (vec (->argument-spec :name (str "root")
                                             :value-name (some (str "path"))
                                             :choices (vec)
                                             :about (str "")
                                             :presence presence/required
                                             :repeats repetition/once))))

(deftest a-missing-argument-is-reported-under-its-value-name
  (assert (= (report-of (spec-with-value-name) (no-words))
             (str "error: missing argument <PATH>\n\n"
                  "Usage: copy [OPTIONS] <PATH>\n\n"
                  "For more information, try `copy --help`."))))

(deftest a-caller-tells-each-kind-of-stop-apart
  (assert (= (kind-of (serve-line (vec "site")))
             "value"))
  (assert (= (kind-of (serve-line (vec "--help")))
             "help"))
  (assert (= (kind-of (serve-line (vec "-V")))
             "version"))
  (assert (= (kind-of (serve-line (vec "--prot")))
             "usage"))
  (assert (= (kind-of (line (serve-spec)
                            (environment-with "COMPLETE" "bash")
                            (vec "--" "-")))
             "completion")))

(deftest a-caller-writes-its-own-sentence-for-a-usage-error
  (assert (= (own-sentence (serve-line (vec "--prot")))
             "usage: unknown option `--prot`"))
  (assert (= (own-sentence (serve-line (vec "--port")))
             "usage: option `--port` needs a value")))
