(use help spec->help spec->usage)
(use support/fixture serve-spec spec-requiring)

(def serve-help
  (str "Serves a folder over HTTP.\n" "\n"
       "Usage: serve [OPTIONS] [root]\n" "\n" "Arguments:\n"
       "  [root]              The folder to serve [default: .]\n"
       "\n" "Options:\n"
       "  -p, --port <port>   The port to listen on [default: 8000]\n"
       "                      [env: SERVE_PORT, PORT]\n"
       "  -o, --open          Opens the browser\n"
       "      --[no-]color    Colors the log\n"
       "  -v, --verbose...    Logs more\n"
       "  -t, --tag <tag>...  Tags the log\n"
       "  -h, --help          Print help\n"
       "  -V, --version       Print version"))

(deftest the-usage-lists-options-then-arguments
  (assert (= (spec->usage (ref (serve-spec)))
             "serve [OPTIONS] [root]")))

(deftest the-usage-marks-a-required-argument
  (assert (= (spec->usage (ref (spec-requiring "file")))
             "copy [OPTIONS] <file>")))

(deftest the-help-page-aligns-and-wraps-to-the-width
  (assert (= (spec->help (ref (serve-spec)) 60)
             serve-help)))

(deftest a-narrow-width-keeps-twenty-columns-for-descriptions
  (assert (= (spec->help (ref (serve-spec)) 10)
             (spec->help (ref (serve-spec)) 42))))
