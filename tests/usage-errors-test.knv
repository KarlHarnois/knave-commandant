(use lib cli-error outcome)

(use support/fixture no-environment no-words parse-texts
                     parse-with spec-requiring)

(defn error-after (texts) (parse-texts texts))

(deftest an-unknown-long-option-is-an-error
  (assert (= (error-after (vec "--prot"))
             (outcome/usage-error (cli-error/unknown-option (str "--prot"))))))

(deftest an-unknown-short-option-is-an-error
  (assert (= (error-after (vec "-x"))
             (outcome/usage-error (cli-error/unknown-option (str "-x"))))))

(deftest only-a-switch-takes-a-negation
  (assert (= (error-after (vec "--no-port"))
             (outcome/usage-error (cli-error/unknown-option (str
                                                              "--no-port"))))))

(deftest an-option-at-the-end-misses-its-value
  (assert (= (error-after (vec "--port"))
             (outcome/usage-error (cli-error/missing-value (str "--port"))))))

(deftest a-flag-is-not-a-value
  (assert (= (error-after (vec "-p" "--open"))
             (outcome/usage-error (cli-error/missing-value (str "-p"))))))

(deftest a-switch-takes-no-value
  (assert (= (error-after (vec "--open=yes"))
             (outcome/usage-error (cli-error/unexpected-value (str
                                                                "--open"))))))

(deftest a-single-value-option-is-given-once
  (assert (= (error-after (vec "--port" "1" "-p" "2"))
             (outcome/usage-error (cli-error/repeated-option (str "-p"))))))

(deftest an-extra-word-is-an-error
  (assert (= (error-after (vec "one" "two"))
             (outcome/usage-error (cli-error/unexpected-argument (str
                                                                   "two"))))))

(deftest a-required-argument-is-missing
  (assert (= (parse-with (spec-requiring "file")
                         (no-environment)
                         (no-words))
             (outcome/usage-error (cli-error/missing-argument (str "file"))))))
