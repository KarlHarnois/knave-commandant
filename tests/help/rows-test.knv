(use help/rows ->help-row arg-rows command-rows option-rows)

(use support/fixture serve-spec site-spec spec-choosing
                     spec-requiring)

(defn option-row-at (index)
  (clone (at (option-rows (ref (serve-spec)))
             index)))

(deftest an-arg-row-notes-its-default
  (assert (= (arg-rows (ref (serve-spec)))
             (vec (->help-row :term (str "[ROOT]")
                              :description (str "The folder to serve [default: .]"))))))

(deftest a-value-option-notes-its-default-and-environment
  (assert (= (option-row-at 0)
             (->help-row :term (str "-p, --port <PORT>")
                         :description (str "The port to listen on [default: 8000] [env: SERVE_PORT, PORT]")))))

(deftest an-off-switch-shows-its-flag
  (assert (= (:term (option-row-at 1)) "-o, --open")))

(deftest an-on-switch-shows-its-negation
  (assert (= (:term (option-row-at 2)) "    --[no-]color")))

(deftest a-count-shows-it-repeats
  (assert (= (:term (option-row-at 3)) "-v, --verbose...")))

(deftest a-many-value-option-shows-it-repeats
  (assert (= (:term (option-row-at 4)) "-t, --tag <TAG>...")))

(deftest every-command-lists-help
  (assert (= (:term (option-row-at 5)) "-h, --help")))

(deftest a-versioned-command-lists-version
  (assert (= (:term (option-row-at 6)) "-V, --version")))

(deftest a-command-without-a-version-lists-only-help
  (assert (= (len (option-rows (ref (spec-requiring "file"))))
             1)))

(deftest a-switch-notes-its-environment-variable
  (assert (= (:description (option-row-at 1))
             "Opens the browser [env: SERVE_OPEN]")))

(defn choice-description (choices)
  (clone (:description (at (option-rows (ref (spec-choosing choices)))
                           0))))

(deftest a-few-choices-show-in-the-term-and-not-in-the-description
  (assert (= (choice-description (vec "text" "json")) "How to print")))

(deftest many-choices-are-listed-in-the-description
  (assert (= (choice-description (vec "a" "b" "c" "d" "e"))
             "How to print [possible values: a, b, c, d, e]")))

(deftest a-group-lists-each-command-and-help
  (assert (= (command-rows (ref (site-spec)))
             (vec (->help-row :term (str "build")
                              :description (str "Builds the site."))
                  (->help-row :term (str "page")
                              :description (str "Manages the pages."))
                  (->help-row :term (str "help")
                              :description (str
                                             "Print the help of a command"))))))

(deftest a-leaf-lists-no-commands
  (assert (empty? (command-rows (ref (serve-spec))))))
