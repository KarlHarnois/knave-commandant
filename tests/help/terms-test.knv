(use help/terms arg-term option-term required-option-term)
(use spec/shapes presence)

(use support/fixture arg-named repeated-arg serve-spec
                     spec-choosing spec-requiring
                     spec-with-lists spec-with-token)

(deftest a-defaulted-arg-shows-in-brackets
  (assert (= (arg-term (at (:args (serve-spec)) 0))
             "[ROOT]")))

(deftest a-required-arg-shows-in-angle-brackets
  (assert (= (arg-term (at (:args (spec-requiring "file")) 0))
             "<FILE>")))

(deftest an-option-shows-its-short-long-and-value
  (assert (= (option-term (at (:options (serve-spec)) 0))
             "-p, --port <PORT>")))

(deftest a-required-option-shows-its-long-and-value
  (assert (= (required-option-term (at (:options (spec-with-token)) 0))
             "--token <TOKEN>")))

(deftest a-repeated-arg-shows-its-dots
  (assert (= (arg-term (ref (repeated-arg "file" presence/required)))
             "<FILE>...")))

(deftest an-arg-that-can-repeat-zero-times-shows-in-brackets
  (assert (= (arg-term (ref (repeated-arg "file" presence/optional)))
             "[FILE]...")))

(deftest an-optional-arg-shows-in-brackets
  (assert (= (arg-term (ref (arg-named "name" presence/optional)))
             "[NAME]")))

(deftest a-delimited-list-option-shows-its-separator
  (assert (= (option-term (at (:options (spec-with-lists)) 0))
             "    --after <AFTER>,...")))

(defn choice-term (choices)
  (option-term (at (:options (spec-choosing choices)) 0)))

(deftest up-to-four-choices-stand-for-the-value
  (assert (= (choice-term (vec "text" "json"))
             "    --format <text|json>"))
  (assert (= (choice-term (vec "a" "b" "c" "d"))
             "    --format <a|b|c|d>")))

(deftest more-than-four-choices-fall-back-to-the-name
  (assert (= (choice-term (vec "a" "b" "c" "d" "e"))
             "    --format <FORMAT>")))
