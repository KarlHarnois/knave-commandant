(use help/terms argument-term option-term
                required-option-term)

(use spec/shapes presence)

(use support/fixture argument-named repeated-argument
                     serve-spec spec-requiring
                     spec-with-lists spec-with-token)

(deftest a-defaulted-argument-shows-in-brackets
  (assert (= (argument-term (at (:arguments (serve-spec)) 0))
             "[ROOT]")))

(deftest a-required-argument-shows-in-angle-brackets
  (assert (= (argument-term (at (:arguments (spec-requiring "file")) 0))
             "<FILE>")))

(deftest an-option-shows-its-short-long-and-value
  (assert (= (option-term (at (:options (serve-spec)) 0))
             "-p, --port <PORT>")))

(deftest a-required-option-shows-its-long-and-value
  (assert (= (required-option-term (at (:options (spec-with-token)) 0))
             "--token <TOKEN>")))

(deftest a-repeated-argument-shows-its-dots
  (assert (= (argument-term (ref (repeated-argument "file" presence/required)))
             "<FILE>...")))

(deftest an-argument-that-can-repeat-zero-times-shows-in-brackets
  (assert (= (argument-term (ref (repeated-argument "file" presence/optional)))
             "[FILE]...")))

(deftest an-optional-argument-shows-in-brackets
  (assert (= (argument-term (ref (argument-named "name" presence/optional)))
             "[NAME]")))

(deftest a-delimited-list-option-shows-its-separator
  (assert (= (option-term (at (:options (spec-with-lists)) 0))
             "    --after <AFTER>,...")))
