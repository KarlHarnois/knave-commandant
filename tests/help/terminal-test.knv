(use support/fixture env-with no-env)
(use help/terminal terminal-width)

(deftest reads-the-width-from-columns
  (assert (= (terminal-width (ref (env-with "COLUMNS" "120")))
             120)))

(deftest defaults-to-eighty-columns
  (assert (= (terminal-width (ref (no-env))) 80)))

(deftest ignores-a-width-that-is-not-a-number
  (assert (= (terminal-width (ref (env-with "COLUMNS" "wide")))
             80)))
