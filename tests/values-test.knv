(use errors ->invalid-text cli-error)

(use matches ->argument-match ->matches ->option-match
             matched-value)

(use spec switch-state)

(use values from-text read-argument read-many read-option
            read-optional value-names)

(defn found ()
  (->matches
    :arguments (vec (->argument-match :name (str "root") :value (str "site")))
    :options (vec (->option-match :long (str "port")
                                  :value (matched-value/one (some (str "80"))))
                  (->option-match :long (str "name")
                                  :value (matched-value/one none))
                  (->option-match :long (str "tag")
                                  :value (matched-value/many (vec (str "1")
                                                                  (str "2"))))
                  (->option-match :long (str "open")
                                  :value (matched-value/switch switch-state/on))
                  (->option-match :long (str "verbose")
                                  :value (matched-value/count 3)))))

(deftest reads-an-argument-as-text
  (assert (= (the (result string _)
                  (read-argument (ref (found)) "root"))
             (ok (str "site")))))

(deftest a-missing-argument-is-an-error
  (assert (= (the (result string _)
                  (read-argument (ref (found)) "path"))
             (err (cli-error/missing-argument (str "path"))))))

(deftest reads-an-option-as-a-number
  (assert (= (the (result u16 _)
                  (read-option (ref (found)) "port"))
             (ok 80))))

(deftest a-value-of-the-wrong-type-is-an-error
  (assert (= (the (result u16 _)
                  (read-option (ref (found)) "tag"))
             (err (cli-error/missing-option (str "--tag"))))))

(deftest text-that-does-not-parse-is-an-invalid-value
  (assert (= (the (result bool _)
                  (read-option (ref (found)) "port"))
             (err (cli-error/invalid-value (->invalid-text
                                             :written (str "--port")
                                             :text (str "80")))))))

(deftest an-absent-optional-value-is-none
  (assert (= (the (result (option u16) _)
                  (read-optional (ref (found)) "name"))
             (ok none))))

(deftest a-given-optional-value-is-some
  (assert (= (the (result (option u16) _)
                  (read-optional (ref (found)) "port"))
             (ok (some 80)))))

(deftest reads-each-value-of-a-list
  (assert (= (the (result (vec u8) _)
                  (read-many (ref (found)) "tag"))
             (ok (vec 1 2)))))

(deftest a-number-type-reads-digits
  (assert (= (the (option u16) (from-text "8080"))
             (some 8080))))

(deftest bool-lists-its-values
  (assert (= (value-names (ref (the (option bool) none)))
             (vec (str "true") (str "false")))))

(deftest a-number-type-lists-no-values
  (assert (empty? (value-names (ref (the (option u16) none))))))
