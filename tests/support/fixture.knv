(module
  "Builds the specs, environments and words the tests run against.")

(use errors ->usage-failure)
(use scan scan-end scan-tokens)
(use tokens words->tokens)

(use lib ->argument-spec ->command-spec ->environment
         ->list-slot ->option-spec ->switch-slot
         ->value-slot ->variable argument-presence
         option-presence outcome parse switch-state
         value-kind)

(export argument-named command-spec-named environment-with
        no-environment no-words parse-texts parse-with
        scanned-texts serve-spec site-spec spec-requiring
        spec-with-arguments spec-with-choices
        spec-with-lists spec-with-token usage-error words)

(defn parse-texts (texts)
  (parse-with (serve-spec) (no-environment) texts))

(defn parse-with (spec environment texts)
  (parse (ref spec)
         (ref environment)
         (ref (words texts))))

(defn words (texts)
  (collect (map (iter texts)
             (fn (text) (str (deref text))))))

(defn serve-spec ()
  (->command-spec
    :name (str "serve")
    :about (str "Serves a folder over HTTP.")
    :version (some (str "1.0.0"))
    :arguments (vec (->argument-spec :name (str "root")
                                     :about (str "The folder to serve")
                                     :presence (argument-presence/defaulted (str
                                                                              "."))))
    :options (vec
               (->option-spec
                 :conflicts-with (vec)
                 :long (str "port")
                 :short (some (char "p"))
                 :about (str "The port to listen on")
                 :value (value-kind/one
                          (->value-slot
                            :placeholder (str "port")
                            :presence (option-presence/defaulted (str "8000"))
                            :env (vec (str "SERVE_PORT") (str "PORT"))
                            :choices (vec))))
               (->option-spec :conflicts-with (vec)
                              :long (str "open")
                              :short (some (char "o"))
                              :about (str "Opens the browser")
                              :value (value-kind/switch
                                       (->switch-slot :initial switch-state/off
                                                      :env (vec (str "SERVE_OPEN")))))
               (->option-spec :conflicts-with (vec)
                              :long (str "color")
                              :short none
                              :about (str "Colors the log")
                              :value (value-kind/switch
                                       (->switch-slot :initial switch-state/on
                                                      :env (vec))))
               (->option-spec :conflicts-with (vec)
                              :long (str "verbose")
                              :short (some (char "v"))
                              :about (str "Logs more")
                              :value value-kind/count)
               (->option-spec :conflicts-with (vec)
                              :long (str "tag")
                              :short (some (char "t"))
                              :about (str "Tags the log")
                              :value (value-kind/many (->list-slot
                                                        :placeholder (str "tag")
                                                        :delimiter none))))
    :subcommands (vec)))

(defn spec-requiring (name)
  (->command-spec :name (str "copy")
                  :about (str "Copies a file.")
                  :version none
                  :arguments (vec (->argument-spec
                                    :name (str name)
                                    :about (str "The file to copy")
                                    :presence argument-presence/required))
                  :options (vec)
                  :subcommands (vec)))

(defn no-environment ()
  (->environment :variables (vec)))

(defn environment-with (name value)
  (->environment :variables (vec (->variable :name (str name)
                                             :value (str value)))))

(defn no-words ()
  (the (vec (ref str)) (vec)))

(defn spec-with-choices ()
  (->command-spec :name (str "log")
                  :about (str "Prints the log.")
                  :version none
                  :arguments (vec)
                  :options (vec (->option-spec :conflicts-with (vec)
                                               :long (str "format")
                                               :short none
                                               :about (str "How to print")
                                               :value (value-kind/one
                                                        (->value-slot
                                                          :placeholder (str "format")
                                                          :presence option-presence/optional
                                                          :env (vec)
                                                          :choices (vec (str "text")
                                                                        (str "json"))))))
                  :subcommands (vec)))

(defn scanned-texts (spec texts)
  (unwrap (finished-scan-of (unwrap-ok (scan-tokens (ref spec)
                                                    (ref (words->tokens (ref (words
                                                                               texts)))))))))

(defn usage-error (failure)
  (outcome/usage-error (->usage-failure :path (vec) :error failure)))

(defn site-spec ()
  (->command-spec :name (str "site")
                  :about (str "Builds and serves a site.")
                  :version (some (str "1.4.0"))
                  :arguments (vec)
                  :options (vec (->option-spec :conflicts-with (vec)
                                               :long (str "verbose")
                                               :short (some (char "v"))
                                               :about (str "Logs more")
                                               :value value-kind/count))
                  :subcommands (vec (build-spec) (page-spec))))

(defn command-spec-named (name about)
  (->command-spec :name (str name)
                  :about (str about)
                  :version none
                  :arguments (vec)
                  :options (vec)
                  :subcommands (vec)))

(defn build-spec ()
  (->command-spec :name (str "build")
                  :about (str "Builds the site.")
                  :version none
                  :arguments (vec (->argument-spec :name (str "root")
                                                   :about (str "The pages")
                                                   :presence (argument-presence/defaulted
                                                               (str "."))))
                  :options (vec (->option-spec
                                  :conflicts-with (vec)
                                  :long (str "port")
                                  :short (some (char "p"))
                                  :about (str "A port")
                                  :value (value-kind/one (->value-slot
                                                           :placeholder (str "port")
                                                           :presence option-presence/optional
                                                           :env (vec)
                                                           :choices (vec)))))
                  :subcommands (vec)))

(defn page-spec ()
  (->command-spec :name (str "page")
                  :about (str "Manages the pages.")
                  :version none
                  :arguments (vec)
                  :options (vec)
                  :subcommands (vec (command-spec-named "add" "Adds a page.")
                                    (command-spec-named "list"
                                                        "Lists the pages."))))

(defn finished-scan-of (end)
  (match end
    ((scanned found) (some (clone (:scan found))))
    (_ none)))

(defn spec-with-token ()
  (->command-spec :name (str "deploy")
                  :about (str "Deploys the site.")
                  :version none
                  :arguments (vec)
                  :options (vec (->option-spec :conflicts-with (vec)
                                               :long (str "token")
                                               :short none
                                               :about (str "The API token")
                                               :value (value-kind/one
                                                        (->value-slot
                                                          :placeholder (str "token")
                                                          :presence option-presence/required
                                                          :env (vec (str "DEPLOY_TOKEN"))
                                                          :choices (vec)))))
                  :subcommands (vec)))

(defn argument-named (name presence)
  (->argument-spec :name (str name)
                   :about (str "")
                   :presence presence))

(defn spec-with-arguments (arguments)
  (->command-spec :name (str "copy")
                  :about (str "Copies files.")
                  :version none
                  :arguments arguments
                  :options (vec)
                  :subcommands (vec)))

(defn spec-with-lists ()
  (->command-spec
    :name (str "add")
    :about (str "Adds an item.")
    :version none
    :arguments (vec)
    :options (vec (->option-spec :conflicts-with (vec)
                                 :long (str "after")
                                 :short none
                                 :about (str "The items it comes after")
                                 :value (value-kind/many (->list-slot
                                                           :placeholder (str "after")
                                                           :delimiter (some (char
                                                                              ",")))))
                  (text-option "description" (vec (str "description-file")))
                  (text-option "description-file" (vec)))
    :subcommands (vec)))

(defn text-option (long conflicts)
  (->option-spec :conflicts-with conflicts
                 :long (str long)
                 :short none
                 :about (str "")
                 :value (value-kind/one (->value-slot
                                          :placeholder (str long)
                                          :presence option-presence/optional
                                          :env (vec)
                                          :choices (vec)))))
