(use spec/argument-order argument-order order-error)
(use spec/shapes presence)

(use support/fixture argument-named repeated-argument
                     spec-with-arguments)

(defn order-of (arguments)
  (argument-order (ref (spec-with-arguments arguments))))

(defn failure-of (arguments)
  (match (order-of arguments)
    ((ok _) none)
    ((err failure) (some failure))))

(deftest a-required-argument-can-follow-a-repeated-one
  (assert (ok? (order-of (vec (repeated-argument "source" presence/required)
                              (argument-named "target" presence/required))))))

(deftest only-one-argument-can-repeat
  (assert (= (failure-of (vec (repeated-argument "a" presence/optional)
                              (repeated-argument "b" presence/optional)))
             (some (order-error/second-repeated (str "b"))))))

(deftest a-required-argument-cannot-follow-an-optional-one
  (assert (= (failure-of (vec (argument-named "a" presence/optional)
                              (argument-named "b" presence/required)))
             (some (order-error/after-optional (str "b"))))))

(deftest only-a-required-argument-can-follow-a-repeated-one
  (assert (= (failure-of (vec (repeated-argument "a" presence/required)
                              (argument-named "b" presence/optional)))
             (some (order-error/after-repeated (str "b"))))))

(deftest a-repeated-argument-cannot-have-a-default
  (assert (= (failure-of
               (vec (repeated-argument "a" (presence/defaulted (str "x")))))
             (some (order-error/repeated-default (str "a"))))))
