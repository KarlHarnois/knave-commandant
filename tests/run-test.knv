(use env ->env ->env-var)
(use run pairs->env)

(deftest each-pair-becomes-an-env-var-with-its-name-and-value
  (assert (= (pairs->env (ref (vec (pair (str "PORT") (str "80"))
                                   (pair (str "HOME") (str "/home/ana")))))
             (->env :vars (vec (->env-var :name (str "PORT") :value (str "80"))
                               (->env-var :name (str "HOME")
                                          :value (str "/home/ana")))))))
