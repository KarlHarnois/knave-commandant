(use env ->env ->variable)
(use run pairs->env)

(deftest each-pair-becomes-a-variable-with-its-name-and-value
  (assert (= (pairs->env (ref (vec (pair (str "PORT") (str "80"))
                                   (pair (str "HOME") (str "/home/ana")))))
             (->env :variables (vec (->variable :name (str "PORT")
                                                :value (str "80"))
                                    (->variable :name (str "HOME")
                                                :value (str "/home/ana")))))))
