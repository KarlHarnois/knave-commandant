(use environment ->environment ->variable)
(use run pairs->environment)

(deftest each-pair-becomes-a-variable-with-its-name-and-value
  (assert (= (pairs->environment (ref (vec (pair (str "PORT") (str "80"))
                                           (pair (str "HOME")
                                                 (str "/home/ana")))))
             (->environment :variables (vec (->variable :name (str "PORT")
                                                        :value (str "80"))
                                            (->variable :name (str "HOME")
                                                        :value (str "/home/ana")))))))
