(use lib ->switch-slot defcommand presence switch-state
         value-kind)

(export matches->probe)

(defcommand probe (:quiet switch :short q)
  (:color switch :initial on :env "PROBE_COLOR")
  (:depth u32
          :default 3
          :env ("PROBE_DEPTH" "DEPTH")
          :about "How deep to go")
  (:token string :required true)
  (:label string))

(defn option-at (index)
  (clone (at (:options (probe-spec)) index)))

(deftest a-short-name-is-recorded
  (assert (= (:short (option-at 0))
             (some (char "q")))))

(deftest a-switch-records-its-initial-state-and-environment
  (assert (= (:value (option-at 1))
             (value-kind/switch (->switch-slot :initial switch-state/on
                                               :env (vec (str
                                                           "PROBE_COLOR")))))))

(deftest a-value-option-records-its-default-and-environment-chain
  (assert (= (:about (option-at 2)) "How deep to go"))
  (assert (= (match (:value (option-at 2))
               ((one slot)
                (some (pair (clone (:presence slot))
                            (clone (:env slot)))))
               (_ none))
             (some (pair (presence/defaulted (str "3"))
                         (vec (str "PROBE_DEPTH") (str "DEPTH")))))))

(defn presence-at (index)
  (match (:value (option-at index))
    ((one slot) (some (clone (:presence slot))))
    (_ none)))

(deftest a-required-option-records-that-it-is-required
  (assert (= (presence-at 3) (some presence/required))))

(deftest an-option-without-a-default-is-optional
  (assert (= (presence-at 4) (some presence/optional))))
