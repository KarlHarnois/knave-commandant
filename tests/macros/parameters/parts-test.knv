(use lib defcommand presence)

(export matches->parts)

(defcommand parts (number u16 :default 8080)
  (word string :default text)
  (quoted string :default "two words"))

(defn default-at (index)
  (clone (:presence (at (:args (parts-spec)) index))))

(deftest a-number-default-becomes-its-digits
  (assert (= (default-at 0)
             (presence/defaulted (str "8080")))))

(deftest a-symbol-default-becomes-its-name
  (assert (= (default-at 1)
             (presence/defaulted (str "text")))))

(deftest a-string-default-stays-as-written
  (assert (= (default-at 2)
             (presence/defaulted (str "two words")))))

(deftest a-parameter-without-about-has-an-empty-about
  (assert (= (:about (at (:args (parts-spec)) 0))
             "")))
