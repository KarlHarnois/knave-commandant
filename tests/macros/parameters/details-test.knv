(use lib ->env defcommand parse-args-from)

(export matches->add-item matches->deploy)

(defcommand deploy "Deploys the site."
  (:token string :required true :about "The API token"))

(defn words (texts)
  (collect (map (iter texts)
             (fn (text) (str (deref text))))))

(defn deploy-after (texts)
  (parse-args-from deploy
                   (->env :variables (vec))
                   (words texts)))

(deftest a-required-option-becomes-a-plain-field
  (assert (= (map-ok (deploy-after (vec "--token" "secret"))
               (fn (deploy) (clone (:token deploy))))
             (ok (str "secret")))))

(defcommand add-item "Adds an item."
  (:after (vec u32)
          :delimiter ","
          :about "The items it comes after")
  (:description string :conflicts-with description-file)
  (:description-file string))

(defn add-after (texts)
  (parse-args-from add-item
                   (->env :variables (vec))
                   (words texts)))

(deftest a-delimited-vec-option-reads-each-part
  (assert (= (map-ok (add-after (vec "--after" "1,2" "--after" "3"))
               (fn (item) (clone (:after item))))
             (ok (vec 1 2 3)))))

(deftest conflicting-options-are-a-usage-error
  (assert (starts-with? (as-str (:text (unwrap-err (map-ok (add-after (vec "--description"
                                                                           "x"
                                                                           "--description-file"
                                                                           "y"))
                                                           (fn (_) 0)))))
                        "error: option `--description` cannot be used with `--description-file`")))
