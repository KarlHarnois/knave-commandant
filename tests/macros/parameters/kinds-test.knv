(use lib defcommand presence repetition value-kind)

(export matches->kinds)

(defcommand kinds (files (vec string))
  (:quiet switch)
  (:verbose count)
  (:tag (vec string))
  (:port u16))

(defn kind-at (index)
  (clone (:value (at (:options (kinds-spec)) index))))

(deftest a-vec-argument-repeats
  (assert (= (:repeats (at (:arguments (kinds-spec)) 0))
             repetition/repeated)))

(deftest a-vec-argument-without-required-is-optional
  (assert (= (:presence (at (:arguments (kinds-spec)) 0))
             presence/optional)))

(deftest a-count-option-counts
  (assert (= (kind-at 1) value-kind/count)))

(deftest a-switch-option-is-a-switch
  (assert (match (kind-at 0)
            ((switch _) true)
            (_ false))))

(deftest a-vec-option-takes-many-values
  (assert (match (kind-at 2)
            ((many _) true)
            (_ false))))

(deftest any-other-type-takes-one-value
  (assert (match (kind-at 3)
            ((one _) true)
            (_ false))))
