(use lib defcommand)

(export matches->both)

(defcommand both (file string) (:quiet switch))

(deftest an-argument-becomes-an-argument-spec
  (assert (= (:name (at (:arguments (both-spec)) 0))
             "file")))

(deftest an-option-becomes-an-option-spec
  (assert (= (:long (at (:options (both-spec)) 0))
             "quiet")))
