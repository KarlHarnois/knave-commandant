(use lib ->early-exit ->env ->variable defchoice defcommand
         output-stream parse-args-from spec->usage
         stop-reason)

(export matches->copy matches->greet matches->hello
        matches->say matches->unlock)

(defchoice tone plain loud)

(defcommand greet "Greets someone."
  :version "2.0.0"
  (who string :about "Who to greet")
  (:times u8 :short n :default 1 :about "How many times")
  (:tone tone :default plain :about "How to greet"))

(defcommand copy "Copies files."
  (sources (vec string)
           :required true
           :about "The files to copy")
  (target string :about "Where to copy them"))

(defcommand hello "Greets someone, or everyone."
  (name (option string) :value-name who :about "Who to greet"))

(defcommand say "Says something."
  (how tone :about "How to say it")
  (:as tone :about "The tone to copy"))

(defn texts->words (texts)
  (collect (map (iter texts)
             (fn (text) (str (deref text))))))

(defn greet-after (texts)
  (parse-args-from greet
                   (->env :variables (vec))
                   (texts->words texts)))

(defn greet-stop (texts)
  (unwrap-err (map-ok (greet-after texts) (fn (_) 0))))

(deftest the-spec-carries-the-name-about-and-version
  (assert (= (:name (greet-spec)) "greet"))
  (assert (= (:about (greet-spec)) "Greets someone."))
  (assert (= (:version (greet-spec))
             (some (str "2.0.0")))))

(deftest the-spec-lists-args-then-options
  (assert (= (spec->usage (ref (greet-spec)))
             "greet [OPTIONS] <WHO>")))

(deftest a-command-line-becomes-the-typed-struct
  (assert (= (greet-after (vec "ana" "-n" "3" "--tone" "loud"))
             (ok (->greet :who (str "ana") :times 3 :tone tone/loud)))))

(deftest absent-options-take-their-defaults
  (assert (= (greet-after (vec "ana"))
             (ok (->greet :who (str "ana") :times 1 :tone tone/plain)))))

(deftest a-value-out-of-range-is-an-invalid-value
  (assert (starts-with? (as-str (:text (greet-stop (vec "ana" "-n" "300"))))
                        "error: invalid value `300` for `--times`: expected a whole number from 0 to 255\n\nUsage: greet"))
  (assert (= (:code (greet-stop (vec "ana" "-n" "300")))
             2)))

(deftest help-comes-back-as-an-early-exit-with-code-0
  (assert (starts-with? (as-str (:text (greet-stop (vec "--help"))))
                        "Greets someone.\n\nUsage: greet"))
  (assert (= (:stream (greet-stop (vec "--help")))
             output-stream/standard-output))
  (assert (= (:code (greet-stop (vec "--help")))
             0)))

(deftest a-vec-arg-takes-every-word-the-next-one-leaves
  (assert (= (parse-args-from copy
                              (->env :variables (vec))
                              (texts->words (vec "a" "b" "c")))
             (ok (->copy :sources (vec (str "a") (str "b"))
                         :target (str "c"))))))

(deftest a-required-vec-arg-shows-it-repeats
  (assert (= (spec->usage (ref (copy-spec)))
             "copy [OPTIONS] <SOURCES>... <TARGET>")))

(deftest an-option-arg-can-be-left-out
  (assert (= (parse-args-from hello
                              (->env :variables (vec))
                              (texts->words (the (vec (ref str)) (vec))))
             (ok (->hello :name none)))))

(deftest an-option-arg-takes-a-given-word
  (assert (= (parse-args-from hello
                              (->env :variables (vec))
                              (texts->words (vec "ana")))
             (ok (->hello :name (some (str "ana")))))))

(deftest a-value-name-shows-in-the-usage
  (assert (= (spec->usage (ref (hello-spec)))
             "hello [OPTIONS] [WHO]")))

(deftest a-choice-arg-and-option-show-their-choices
  (assert (= (spec->usage (ref (say-spec)))
             "say [OPTIONS] <plain|loud>"))
  (assert (= (:choices (at (:args (say-spec)) 0))
             (vec (str "plain") (str "loud")))))

(deftest a-completion-request-comes-back-as-an-early-exit
  (assert (= (map-ok (parse-args-from copy
                                      (->env :variables (vec (->variable
                                                               :name (str "COMPLETE")
                                                               :value (str "bash"))))
                                      (texts->words (vec "--" "-")))
                     (fn (_) 0))
             (err (->early-exit :text (str "words\n--help")
                                :stream output-stream/standard-output
                                :code 0
                                :reason stop-reason/completion)))))

(deftest a-value-outside-a-choice-names-the-choices
  (assert (starts-with? (as-str (:text (greet-stop
                                         (vec "ana" "--tone" "soft"))))
                        "error: invalid value `soft` for `--tone`: expected one of plain, loud\n\nUsage: greet")))

(defstruct pin
  :digits string)

(defn text->pin (text)
  (if (= (len text) 4)
    (ok (->pin :digits (str text)))
    (err none)))

(defstruct label
  :text string)

(defn text->label (text)
  (if (starts-with? text "#")
    (ok (->label :text (str text)))
    (err (some (str "a label starts with `#`")))))

(defcommand unlock "Unlocks a door."
  (code pin :parse text->pin :about "The door's code")
  (:label label
          :parse text->label
          :about "A label for the log"))

(defn unlock-report (texts)
  (clone (:text (unwrap-err (map-ok (parse-args-from unlock
                                                     (->env :variables (vec))
                                                     (texts->words texts))
                                    (fn (_) 0))))))

(deftest a-custom-type-reads-its-value
  (assert (= (parse-args-from unlock
                              (->env :variables (vec))
                              (texts->words (vec "1234" "--label" "#front")))
             (ok (->unlock :code (->pin :digits (str "1234"))
                           :label (some (->label :text (str "#front"))))))))

(deftest a-custom-type-without-a-reason-gets-the-plain-error
  (assert (starts-with?
            (as-str (unlock-report (vec "12")))
            "error: invalid value `12` for `<CODE>`\n\nUsage: unlock")))

(deftest a-custom-type-with-a-reason-ends-the-error-with-it
  (assert (starts-with? (as-str (unlock-report (vec "1234" "--label" "front")))
                        "error: invalid value `front` for `--label`: a label starts with `#`\n\nUsage: unlock")))
