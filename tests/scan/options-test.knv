(use errors/cli-error cli-error)
(use scan/items flag)
(use scan/options scan-assignment! scan-flag!)
(use scan/state ->scan occurrence-value step)
(use scan/hits stop)
(use support/fixture serve-spec words)
(use scan/tokens words->tokens)

(defn flag-step (texts flag)
  (let (scan (->scan :path (vec)
                     :positionals (vec)
                     :occurrences (vec)))
    (scan-flag! (ref (serve-spec))
                (ref (words->tokens (ref (words texts))))
                0
                (mut scan)
                (ref flag))))

(defn assignment-step (flag value)
  (let (scan (->scan :path (vec)
                     :positionals (vec)
                     :occurrences (vec)))
    (scan-assignment! (ref (serve-spec))
                      0
                      (mut scan)
                      (ref flag)
                      (ref (str value)))))

(defn recorded-value (texts flag)
  (let (scan (->scan :path (vec)
                     :positionals (vec)
                     :occurrences (vec)))
    (scan-flag! (ref (serve-spec))
                (ref (words->tokens (ref (words texts))))
                0
                (mut scan)
                (ref flag))
    (map-some (first (:occurrences scan))
      (fn (found) (clone (:value found))))))

(deftest a-switch-moves-one-token-on
  (assert (= (flag-step (vec "--open")
                        (flag/long (str "open")))
             (ok (step/advance 1)))))

(deftest a-value-option-takes-the-next-token
  (assert (= (flag-step (vec "--port" "80")
                        (flag/long (str "port")))
             (ok (step/advance 2))))
  (assert (= (recorded-value (vec "--port" "80")
                             (flag/long (str "port")))
             (some (occurrence-value/text (str "80"))))))

(deftest help-halts-the-scan
  (assert (= (flag-step (vec "-h")
                        (flag/short (char "h")))
             (ok (step/halt stop/help-asked)))))

(deftest an-unknown-flag-is-an-error
  (assert (= (flag-step (vec "--prot")
                        (flag/long (str "prot")))
             (err (cli-error/unknown-option (str "--prot"))))))

(deftest an-option-at-the-end-misses-its-value
  (assert (= (flag-step (vec "--port")
                        (flag/long (str "port")))
             (err (cli-error/missing-value (str "--port"))))))

(deftest a-flag-is-not-a-value
  (assert (= (flag-step (vec "-p" "--open")
                        (flag/short (char "p")))
             (err (cli-error/missing-value (str "-p"))))))

(deftest a-double-dash-is-not-a-value
  (assert (= (flag-step (vec "--port" "--" "80")
                        (flag/long (str "port")))
             (err (cli-error/missing-value (str "--port"))))))

(deftest a-negative-number-is-a-value
  (assert (= (recorded-value (vec "--port" "-5")
                             (flag/long (str "port")))
             (some (occurrence-value/text (str "-5"))))))

(deftest a-negation-records-off
  (assert (= (recorded-value (vec "--no-color")
                             (flag/long (str "no-color")))
             (some occurrence-value/negated))))

(deftest a-switch-takes-no-attached-value
  (assert (= (assignment-step (flag/long (str "open")) "yes")
             (err (cli-error/unexpected-value (str "--open"))))))

(deftest a-negation-takes-no-attached-value
  (assert (= (assignment-step (flag/long (str "no-color")) "yes")
             (err (cli-error/unexpected-value (str "--no-color"))))))

(deftest help-takes-no-attached-value
  (assert (= (assignment-step (flag/long (str "help")) "x")
             (err (cli-error/unexpected-value (str "--help"))))))

(deftest an-unknown-assignment-keeps-its-whole-spelling
  (assert (= (assignment-step (flag/long (str "")) "x")
             (err (cli-error/unknown-option (str "--=x"))))))

(deftest an-attached-value-is-recorded
  (assert (= (assignment-step (flag/long (str "port")) "80")
             (ok (step/advance 1)))))
