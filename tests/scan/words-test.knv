(use errors/cli-error cli-error)
(use scan/hits stop)
(use scan/state ->scan step)
(use scan/words scan-word!)
(use support/fixture serve-spec site-spec words)
(use scan/tokens words->tokens)

(defn descended-name (texts)
  (match (word-step (site-spec) texts)
    ((ok (descend found)) (some (clone (:name found))))
    (_ none)))

(defn word-step (spec texts)
  (let (scan (->scan :path (vec)
                     :positionals (vec)
                     :occurrences (vec)))
    (scan-word! (ref spec)
                (ref (words->tokens (ref (words texts))))
                0
                (mut scan)
                (ref (str (deref (at texts 0)))))))

(defn word-path (spec texts)
  (let (scan (->scan :path (vec)
                     :positionals (vec)
                     :occurrences (vec)))
    (scan-word! (ref spec)
                (ref (words->tokens (ref (words texts))))
                0
                (mut scan)
                (ref (str (deref (at texts 0)))))
    (clone (:path scan))))

(deftest a-word-of-a-leaf-command-is-an-argument
  (assert (= (word-step (serve-spec) (vec "site"))
             (ok (step/advance 1)))))

(deftest a-command-name-descends-into-it
  (assert (= (descended-name (vec "build"))
             (some (str "site build")))))

(deftest a-command-name-joins-the-path
  (assert (= (word-path (site-spec) (vec "page"))
             (vec (str "page")))))

(deftest an-unknown-word-in-a-group-is-an-unknown-command
  (assert (= (word-step (site-spec) (vec "biuld"))
             (err (cli-error/unknown-command (str "biuld"))))))

(deftest help-asks-for-the-named-command
  (assert (= (word-step (site-spec) (vec "help" "page"))
             (ok (step/halt stop/help-asked))))
  (assert (= (word-path (site-spec) (vec "help" "page"))
             (vec (str "page")))))
