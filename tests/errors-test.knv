(use errors ->invalid-text cli-error error->message)

(deftest names-an-unknown-option
  (assert (= (error->message (cli-error/unknown-option (str "--prot")))
             "unknown option `--prot`")))

(deftest names-an-option-missing-its-value
  (assert (= (error->message (cli-error/missing-value (str "-p")))
             "option `-p` needs a value")))

(deftest names-a-switch-given-a-value
  (assert (= (error->message (cli-error/unexpected-value (str "--open")))
             "option `--open` takes no value")))

(deftest names-a-repeated-option
  (assert (= (error->message (cli-error/repeated-option (str "-p")))
             "option `-p` is given more than once")))

(deftest names-an-extra-argument
  (assert (= (error->message (cli-error/unexpected-argument (str "two")))
             "unexpected argument `two`")))

(deftest names-a-missing-argument
  (assert (= (error->message (cli-error/missing-argument (str "file")))
             "missing argument <file>")))

(deftest names-a-missing-required-option
  (assert (= (error->message (cli-error/missing-option (str "--manager")))
             "option `--manager` is required")))

(deftest names-an-invalid-value-and-where-it-was-given
  (assert (= (error->message (cli-error/invalid-value (->invalid-text
                                                        :written (str "--port")
                                                        :text (str "abc"))))
             "invalid value `abc` for `--port`")))
