(use shares shares-of split-of taken-total)
(use spec argument-presence)
(use support/fixture argument-named spec-with-arguments)

(defn starts-and-counts (spec given)
  (collect (map (iter (shares-of (ref spec)
                                 (ref (split-of (ref spec) given))))
                (fn (taken)
                  (pair (:start taken) (:count taken))))))

(defn copy-spec ()
  (spec-with-arguments (vec
                         (argument-named "source" argument-presence/one-or-more)
                         (argument-named "target" argument-presence/required))))

(deftest the-repeated-argument-takes-the-words-in-the-middle
  (assert (= (starts-and-counts (copy-spec) 4)
             (vec (pair 0 3) (pair 3 1)))))

(deftest the-argument-after-a-repeated-one-is-filled-first
  (assert (= (starts-and-counts (copy-spec) 1)
             (vec (pair 0 0) (pair 0 1)))))

(deftest without-a-repeated-argument-every-word-past-the-last-is-left
  (assert (= (taken-total (ref (split-of (ref (spec-with-arguments (vec (argument-named
                                                                          "name"
                                                                          argument-presence/required))))
                                         3)))
             1)))
