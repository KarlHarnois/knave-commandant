(use resolve/delimited list-texts)

(deftest a-delimiter-splits-each-value
  (assert (= (list-texts (vec (str "1,2") (str "3"))
                         (some (char ",")))
             (vec (str "1") (str "2") (str "3")))))

(deftest a-delimiter-drops-blank-parts-and-spaces
  (assert (= (list-texts (vec (str "1, 2,"))
                         (some (char ",")))
             (vec (str "1") (str "2")))))

(deftest without-a-delimiter-each-value-stays-whole
  (assert (= (list-texts (vec (str "1,2")) none)
             (vec (str "1,2")))))
