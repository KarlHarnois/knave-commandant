(use errors/cli-error cli-error)
(use values/matches arg-text one-text option-value)
(use resolve/matches-of resolve)

(use support/fixture env-with no-env no-words scanned-texts
                     serve-spec spec-with-token)

(defn resolved (texts)
  (let (spec (serve-spec))
    (resolve (ref spec)
             (ref (no-env))
             (ref (scanned-texts spec texts)))))

(deftest fills-the-args
  (assert (= (arg-text (ref (unwrap-ok (resolved (vec "site"))))
                       "root")
             (some (ref (str "site"))))))

(deftest settles-every-option
  (assert (some? (option-value (ref (unwrap-ok (resolved (no-words))))
                               "tag"))))

(deftest a-single-value-option-is-given-once
  (assert (= (resolved (vec "--port" "1" "-p" "2"))
             (err (cli-error/repeated-option (str "-p"))))))

(defn resolved-token (env texts)
  (let (spec (spec-with-token))
    (resolve (ref spec)
             (ref env)
             (ref (scanned-texts spec texts)))))

(deftest a-required-option-must-be-given
  (assert (= (resolved-token (no-env) (no-words))
             (err (cli-error/missing-option (str "--token"))))))

(deftest a-required-option-can-come-from-its-env-variable
  (assert (= (one-text (ref (unwrap-ok (resolved-token (env-with "DEPLOY_TOKEN"
                                                                 "secret")
                                                       (no-words))))
                       "token")
             (some (str "secret")))))
