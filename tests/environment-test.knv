(use environment ->environment ->variable first-set)

(defn environment-of (name value)
  (->environment :variables (vec (->variable :name (str name)
                                             :value (str value)))))

(defn port-names ()
  (vec (str "SERVE_PORT") (str "PORT")))

(deftest the-first-name-that-is-set-wins
  (assert (= (first-set (ref (environment-of "SERVE_PORT" "90"))
                        (ref (port-names)))
             (some (str "90")))))

(deftest a-later-name-is-a-fallback
  (assert (= (first-set (ref (environment-of "PORT" "91"))
                        (ref (port-names)))
             (some (str "91")))))

(deftest no-set-name-gives-nothing
  (assert (= (first-set (ref (environment-of "HOME" "/"))
                        (ref (port-names)))
             none)))
