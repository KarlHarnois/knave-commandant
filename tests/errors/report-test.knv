(use errors/report error-report failure-report)
(use help/page spec->help)
(use spec/commands spec-at)

(use errors/cli-error ->invalid-text ->usage-failure
                      cli-error)

(use support/fixture serve-spec site-spec spec-requiring
                     spec-with-choices)

(defn report-for (failure)
  (error-report (ref (serve-spec))
                (ref failure)))

(defn contains-text? (text part)
  (> (count (split (as-str text) part)) 1))

(deftest an-unknown-assignment-gets-a-tip-from-its-name
  (assert (contains-text? (report-for (cli-error/unknown-option (str
                                                                  "--prot=80")))
                          "`--port`")))

(deftest a-mistyped-option-gets-a-tip
  (assert (= (report-for (cli-error/unknown-option (str "--prot")))
             (str "error: unknown option `--prot`\n\n"
                  "  tip: a similar option exists: `--port`\n\n"
                  "Usage: serve [OPTIONS] [ROOT]\n\n"
                  "For more information, try `serve --help`."))))

(deftest a-distant-option-gets-no-tip
  (assert (= (report-for (cli-error/unknown-option (str "--zzzzzz")))
             (str "error: unknown option `--zzzzzz`\n\n"
                  "Usage: serve [OPTIONS] [ROOT]\n\n"
                  "For more information, try `serve --help`."))))

(deftest a-builtin-can-be-the-tip
  (assert (contains-text? (report-for (cli-error/unknown-option (str "--hepl")))
                          "`--help`")))

(deftest version-is-no-tip-without-a-version
  (assert (not (contains-text? (error-report (ref (spec-requiring "file"))
                                             (ref (cli-error/unknown-option (str
                                                                              "--versoin"))))
                               "tip"))))

(deftest a-short-option-gets-no-tip
  (assert (not (contains-text? (report-for (cli-error/unknown-option (str
                                                                       "-x")))
                               "tip"))))

(deftest an-invalid-choice-lists-the-possible-values
  (assert (contains-text? (error-report (ref (spec-with-choices))
                                        (ref (cli-error/invalid-value
                                               (->invalid-text :written (str "--format")
                                                               :text (str "xml")))))
                          "  tip: possible values: text, json")))

(deftest an-invalid-number-gets-no-tip
  (assert (not (contains-text? (report-for (cli-error/invalid-value
                                             (->invalid-text :written (str "--port")
                                                             :text (str
                                                                     "abc"))))
                               "tip"))))

(deftest a-mistyped-command-gets-a-tip
  (assert (contains-text? (error-report (ref (site-spec))
                                        (ref (cli-error/unknown-command (str "biuld"))))
                          "  tip: a similar command exists: `build`")))

(deftest a-failure-reports-the-usage-of-its-command
  (assert (contains-text? (failure-report (ref (site-spec))
                                          (ref (->usage-failure :path (vec (str "page"))
                                                                :error (cli-error/unknown-command
                                                                         (str "ad"))))
                                          80)
                          "Usage: site page [OPTIONS] <COMMAND>")))

(deftest a-missing-command-reports-the-help-of-its-group
  (assert (= (failure-report (ref (site-spec))
                             (ref (->usage-failure
                                    :path (vec (str "page"))
                                    :error cli-error/missing-command))
                             80)
             (spec->help (ref (unwrap (spec-at (ref (site-spec))
                                               (ref (vec (str "page"))))))
                         80))))
