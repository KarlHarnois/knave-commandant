(use errors/suggest closest-name edit-distance)

(defn names ()
  (vec (str "port")
       (str "open")
       (str "help")))

(deftest counts-the-edits-between-two-names
  (assert (= (edit-distance "prot" "port") 2)))

(deftest counts-no-edit-for-the-same-name
  (assert (= (edit-distance "port" "port") 0)))

(deftest counts-each-character-of-an-empty-name
  (assert (= (edit-distance "" "abc") 3)))

(deftest suggests-the-closest-name
  (assert (= (closest-name "prot" (ref (names)))
             (some (str "port")))))

(deftest suggests-nothing-for-a-distant-name
  (assert (= (closest-name "zzzz" (ref (names)))
             none)))
