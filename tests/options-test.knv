(use lib matched-value switch-state)
(use support/fixture no-words option-after)

(defn port-text (text)
  (some (matched-value/one (some (str text)))))

(deftest long-option-takes-the-next-word
  (assert (= (option-after (vec "--port" "80") "port")
             (port-text "80"))))

(deftest long-option-takes-an-attached-value
  (assert (= (option-after (vec "--port=80") "port")
             (port-text "80"))))

(deftest short-option-takes-the-next-word
  (assert (= (option-after (vec "-p" "80") "port")
             (port-text "80"))))

(deftest short-option-takes-an-attached-value
  (assert (= (option-after (vec "-p80") "port")
             (port-text "80"))))

(deftest a-cluster-ends-with-a-value
  (assert (= (option-after (vec "-vvp80") "port")
             (port-text "80"))))

(deftest a-cluster-sets-each-switch
  (assert (= (option-after (vec "-vo") "open")
             (some (matched-value/switch switch-state/on)))))

(deftest an-absent-option-takes-its-default
  (assert (= (option-after (no-words) "port")
             (port-text "8000"))))

(deftest an-absent-switch-keeps-its-initial-state
  (assert (= (option-after (no-words) "open")
             (some (matched-value/switch switch-state/off)))))

(deftest a-negation-turns-a-switch-off
  (assert (= (option-after (vec "--no-color") "color")
             (some (matched-value/switch switch-state/off)))))

(deftest the-last-of-a-switch-and-its-negation-wins
  (assert (= (option-after (vec "--no-color" "--color") "color")
             (some (matched-value/switch switch-state/on)))))

(deftest a-repeated-short-flag-counts
  (assert (= (option-after (vec "-vvv") "verbose")
             (some (matched-value/count 3)))))

(deftest a-repeated-option-collects-its-values
  (assert (= (option-after (vec "--tag" "a" "-t" "b") "tag")
             (some (matched-value/many (vec (str "a") (str "b")))))))

(deftest options-may-follow-the-argument
  (assert (= (option-after (vec "site" "--port" "80") "port")
             (port-text "80"))))
