(use errors/cli-error ->invalid-text cli-error)

(use values/matches ->arg-match ->matches ->option-match
                    matched-value)

(use spec/shapes switch-state)

(use values/builtin text->bool text->string text->u16
                    text->u8)

(use values/convert read-arg read-args read-many read-option
                    read-optional read-optional-arg)

(defn found ()
  (->matches :path (vec)
             :args (vec (->arg-match :name (str "root")
                                     :placeholder (str "root")
                                     :values (vec (str "site")))
                        (->arg-match :name (str "ports")
                                     :placeholder (str "ports")
                                     :values (vec (str "80") (str "81")))
                        (->arg-match :name (str "label")
                                     :placeholder (str "label")
                                     :values (vec)))
             :options (vec (->option-match :long (str "port")
                                           :value (matched-value/one (some (str "80"))))
                           (->option-match :long (str "name")
                                           :value (matched-value/one none))
                           (->option-match :long (str "tag")
                                           :value (matched-value/many (vec (str "1")
                                                                           (str "2"))))
                           (->option-match :long (str "open")
                                           :value (matched-value/switch
                                                    switch-state/on))
                           (->option-match :long (str "verbose")
                                           :value (matched-value/count 3)))))

(deftest reads-an-arg-as-text
  (assert (= (read-arg (ref (found)) "root" text->string)
             (ok (str "site")))))

(deftest a-missing-arg-is-an-error
  (assert (= (read-arg (ref (found)) "path" text->string)
             (err (cli-error/missing-arg (str "path"))))))

(deftest reads-an-option-as-a-number
  (assert (= (read-option (ref (found)) "port" text->u16)
             (ok 80))))

(deftest a-value-of-the-wrong-type-is-an-error
  (assert (= (read-option (ref (found)) "tag" text->u16)
             (err (cli-error/missing-option (str "--tag"))))))

(deftest text-that-does-not-parse-is-an-invalid-value
  (assert (= (read-option (ref (found)) "port" text->bool)
             (err (cli-error/invalid-value (->invalid-text :written (str
                                                                      "--port")
                                                           :text (str "80")
                                                           :why (some (str "expected true or false"))))))))

(deftest an-absent-optional-value-is-none
  (assert (= (read-optional (ref (found)) "name" text->u16)
             (ok none))))

(deftest a-given-optional-value-is-some
  (assert (= (read-optional (ref (found)) "port" text->u16)
             (ok (some 80)))))

(deftest reads-each-value-of-a-list
  (assert (= (read-many (ref (found)) "tag" text->u8)
             (ok (vec 1 2)))))

(deftest reads-every-word-of-a-repeated-arg
  (assert (= (read-args (ref (found)) "ports" text->u16)
             (ok (vec 80 81)))))

(deftest an-absent-optional-arg-is-none
  (assert (= (read-optional-arg (ref (found)) "label" text->string)
             (ok none))))

(deftest a-given-optional-arg-is-some
  (assert (= (read-optional-arg (ref (found)) "root" text->string)
             (ok (some (str "site"))))))
