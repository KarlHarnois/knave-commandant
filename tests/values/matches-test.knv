(use spec/shapes switch-state)

(use values/matches ->arg-match ->matches ->option-match
                    arg-text arg-texts command-at
                    matched-value option-value read-count
                    read-switch shifted)

(defn found ()
  (->matches :path (vec)
             :args (vec (->arg-match :name (str "root")
                                     :placeholder (str "root")
                                     :values (vec (str "site"))))
             :options (vec (->option-match :long (str "verbose")
                                           :value (matched-value/count 2)))))

(defn chosen ()
  (->matches :path (vec (str "page") (str "add"))
             :args (vec)
             :options (vec)))

(deftest reads-an-arg-by-name
  (assert (= (arg-text (ref (found)) "root")
             (some (ref (str "site"))))))

(deftest an-unknown-arg-reads-nothing
  (assert (= (arg-text (ref (found)) "path") none)))

(deftest reads-an-option-by-long-name
  (assert (= (option-value (ref (found)) "verbose")
             (some (ref (matched-value/count 2))))))

(deftest an-unknown-option-reads-nothing
  (assert (= (option-value (ref (found)) "quiet")
             none)))

(deftest reads-a-count
  (assert (= (read-count (ref (found)) "verbose")
             2)))

(deftest an-absent-count-reads-zero
  (assert (= (read-count (ref (found)) "quiet") 0)))

(deftest an-absent-switch-reads-off
  (assert (= (read-switch (ref (found)) "open")
             switch-state/off)))

(deftest reads-the-first-command-of-the-path
  (assert (= (command-at (ref (chosen))) "page")))

(deftest an-empty-path-has-no-command
  (assert (= (command-at (ref (found))) "")))

(deftest shifting-drops-the-first-command
  (assert (= (:path (shifted (ref (chosen))))
             (vec (str "add")))))

(deftest reads-every-word-of-an-arg
  (assert (= (arg-texts (ref (found)) "root")
             (vec (str "site")))))

(deftest an-unknown-arg-has-no-words
  (assert (empty? (arg-texts (ref (found)) "path"))))
