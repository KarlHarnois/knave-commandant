(use env ->env ->env-var first-set)

(defn env-of (name value)
  (->env :vars (vec (->env-var :name (str name) :value (str value)))))

(defn port-names ()
  (vec (str "SERVE_PORT") (str "PORT")))

(deftest the-first-name-that-is-set-wins
  (assert (= (first-set (ref (env-of "SERVE_PORT" "90"))
                        (ref (port-names)))
             (some (str "90")))))

(deftest a-later-name-is-a-fallback
  (assert (= (first-set (ref (env-of "PORT" "91"))
                        (ref (port-names)))
             (some (str "91")))))

(deftest no-set-name-gives-nothing
  (assert (= (first-set (ref (env-of "HOME" "/"))
                        (ref (port-names)))
             none)))
