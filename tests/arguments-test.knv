(use arguments resolve-arguments)
(use errors cli-error)
(use matches ->argument-match)
(use spec argument-presence)

(use support/fixture argument-named no-words serve-spec
                     spec-requiring spec-with-arguments
                     words)

(defn arguments-of (spec texts)
  (resolve-arguments (ref spec)
                     (ref (words texts))))

(deftest a-word-fills-the-argument
  (assert (= (arguments-of (serve-spec) (vec "site"))
             (ok (vec (->argument-match :name (str "root")
                                        :values (vec (str "site"))))))))

(deftest an-absent-argument-takes-its-default
  (assert (= (arguments-of (serve-spec) (no-words))
             (ok (vec (->argument-match :name (str "root")
                                        :values (vec (str "."))))))))

(deftest an-extra-word-is-an-error
  (assert (= (arguments-of (serve-spec) (vec "one" "two"))
             (err (cli-error/unexpected-argument (str "two"))))))

(deftest a-required-argument-is-missing
  (assert (= (arguments-of (spec-requiring "file") (no-words))
             (err (cli-error/missing-argument (str "file"))))))

(defn copy-spec ()
  (spec-with-arguments (vec
                         (argument-named "source" argument-presence/one-or-more)
                         (argument-named "target" argument-presence/required))))

(deftest a-repeated-argument-leaves-the-last-word-to-the-one-after-it
  (assert (= (arguments-of (copy-spec) (vec "a" "b" "c"))
             (ok (vec (->argument-match :name (str "source")
                                        :values (vec (str "a") (str "b")))
                      (->argument-match :name (str "target")
                                        :values (vec (str "c"))))))))

(deftest a-repeated-argument-that-needs-one-word-is-missing-without-it
  (assert (= (arguments-of (copy-spec) (vec "c"))
             (err (cli-error/missing-argument (str "source"))))))

(deftest a-repeated-argument-can-take-no-words
  (assert (= (arguments-of (spec-with-arguments (vec (argument-named "file"
                                                                     argument-presence/zero-or-more)))
                           (no-words))
             (ok (vec (->argument-match :name (str "file") :values (vec)))))))

(deftest an-absent-optional-argument-has-no-value
  (assert (= (arguments-of (spec-with-arguments (vec (argument-named "name"
                                                                     argument-presence/optional)))
                           (no-words))
             (ok (vec (->argument-match :name (str "name") :values (vec)))))))
