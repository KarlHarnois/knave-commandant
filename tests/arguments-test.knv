(use lib argument-text outcome)
(use support/fixture no-words parse-texts)

(defn root-after (texts)
  (match (parse-texts texts)
    ((parsed found)
     (map-some (argument-text (ref found) "root") clone))
    (_ none)))

(deftest a-word-fills-the-argument
  (assert (= (root-after (vec "site"))
             (some (str "site")))))

(deftest an-absent-argument-takes-its-default
  (assert (= (root-after (no-words))
             (some (str ".")))))

(deftest a-lone-dash-is-an-argument
  (assert (= (root-after (vec "-"))
             (some (str "-")))))

(deftest a-double-dash-ends-the-options
  (assert (= (root-after (vec "--" "--open"))
             (some (str "--open")))))

(deftest an-argument-may-follow-the-options
  (assert (= (root-after (vec "--port" "80" "site"))
             (some (str "site")))))
