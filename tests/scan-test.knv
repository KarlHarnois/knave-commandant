(use errors ->usage-failure cli-error)
(use scan scan-end scan-tokens)
(use support/fixture serve-spec site-spec words)
(use tokens words->tokens)

(defn positionals-of (texts)
  (match (scan-of texts)
    ((ok (scanned found))
     (some (clone (:positionals (:scan found)))))
    (_ none)))

(defn occurrence-count (texts)
  (match (scan-of texts)
    ((ok (scanned found))
     (some (len (:occurrences (:scan found)))))
    (_ none)))

(defn path-of (texts)
  (match (site-scan texts)
    ((ok (scanned found)) (some (clone (:path (:scan found)))))
    (_ none)))

(defn occurrences-in-site (texts)
  (match (site-scan texts)
    ((ok (scanned found))
     (some (len (:occurrences (:scan found)))))
    (_ none)))

(defn scan-of (texts)
  (scan-tokens (ref (serve-spec))
               (ref (words->tokens (ref (words texts))))))

(defn failed (failure)
  (err (->usage-failure :path (vec) :error failure)))

(defn site-scan (texts)
  (scan-tokens (ref (site-spec))
               (ref (words->tokens (ref (words texts))))))

(deftest words-around-flags-stay-in-order
  (assert (= (positionals-of (vec "a" "--open" "b"))
             (some (vec (str "a") (str "b"))))))

(deftest each-flag-records-an-occurrence
  (assert (= (occurrence-count (vec "--open" "-p" "80" "-vv"))
             (some 4))))

(deftest help-stops-the-scan
  (assert (= (scan-of (vec "-h" "--port"))
             (ok (scan-end/help (vec))))))

(deftest version-stops-the-scan
  (assert (= (scan-of (vec "--version"))
             (ok (scan-end/version (str "1.0.0"))))))

(deftest a-flag-error-stops-the-scan
  (assert (= (scan-of (vec "--prot"))
             (failed (cli-error/unknown-option (str "--prot"))))))

(deftest a-command-word-enters-the-subcommand
  (assert (= (path-of (vec "page" "add"))
             (some (vec (str "page") (str "add"))))))

(deftest global-options-are-read-after-the-command
  (assert (= (occurrences-in-site (vec "build" "-v" "-p" "80"))
             (some 2))))

(deftest a-subcommand-reads-its-own-short-values
  (assert (= (occurrences-in-site (vec "build" "-p80"))
             (some 1))))

(deftest a-group-needs-a-command
  (assert (= (site-scan (vec "page"))
             (err (->usage-failure :path (vec (str "page"))
                                   :error cli-error/missing-command)))))

(deftest an-unknown-command-is-an-error
  (assert (= (site-scan (vec "biuld"))
             (err (->usage-failure :path (vec)
                                   :error (cli-error/unknown-command (str "biuld")))))))

(deftest help-names-the-command-to-describe
  (assert (= (site-scan (vec "help" "page" "add"))
             (ok (scan-end/help (vec (str "page") (str "add")))))))

(deftest help-inside-a-command-describes-it
  (assert (= (site-scan (vec "page" "-h"))
             (ok (scan-end/help (vec (str "page")))))))

(deftest help-for-an-unknown-command-is-an-error
  (assert (= (site-scan (vec "help" "nope"))
             (err (->usage-failure :path (vec)
                                   :error (cli-error/unknown-command (str "nope")))))))
