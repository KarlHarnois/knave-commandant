(use errors cli-error)
(use matches argument-text option-value)
(use resolve resolve)

(use support/fixture no-environment no-words scanned-texts
                     serve-spec)

(defn resolved (texts)
  (let (spec (serve-spec))
    (resolve (ref spec)
             (ref (no-environment))
             (ref (scanned-texts spec texts)))))

(deftest fills-the-arguments
  (assert (= (argument-text (ref (unwrap-ok (resolved (vec "site"))))
                            "root")
             (some (ref (str "site"))))))

(deftest settles-every-option
  (assert (some? (option-value (ref (unwrap-ok (resolved (no-words))))
                               "tag"))))

(deftest a-single-value-option-is-given-once
  (assert (= (resolved (vec "--port" "1" "-p" "2"))
             (err (cli-error/repeated-option (str "-p"))))))
