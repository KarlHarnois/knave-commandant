(use errors cli-error)
(use items tokens->items)
(use matches argument-text option-value)
(use resolve resolve)
(use scan scan-end scan-items)

(use support/fixture no-environment no-words serve-spec
                     words)

(use tokens words->tokens)

(defn resolved (texts)
  (let (spec (serve-spec))
    (resolve (ref spec)
             (ref (no-environment))
             (ref (scan-of (ref spec) texts)))))

(defn scan-of (spec texts)
  (let (items (tokens->items spec
                             (ref (words->tokens (ref (words texts))))))
    (unwrap (scanned (unwrap-ok (scan-items spec (ref items)))))))

(defn scanned (end)
  (match end
    ((scanned found) (some found))
    (_ none)))

(deftest fills-the-arguments
  (assert (= (argument-text (ref (unwrap-ok (resolved (vec "site"))))
                            "root")
             (some (ref (str "site"))))))

(deftest settles-every-option
  (assert (some? (option-value (ref (unwrap-ok (resolved (no-words))))
                               "tag"))))

(deftest a-single-value-option-is-given-once
  (assert (= (resolved (vec "--port" "1" "-p" "2"))
             (err (cli-error/repeated-option (str "-p"))))))
