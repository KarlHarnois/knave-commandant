(use errors ->usage-failure cli-error)
(use matches argument-text)
(use parse outcome)

(use support/fixture no-environment parse-texts parse-with
                     site-spec spec-with-token usage-error)

(defn root-after (texts)
  (match (parse-texts texts)
    ((parsed found)
     (map-some (argument-text (ref found) "root") clone))
    (_ none)))

(deftest a-valid-line-parses-into-matches
  (assert (= (root-after (vec "site"))
             (some (str "site")))))

(deftest help-becomes-the-help-outcome
  (assert (= (parse-texts (vec "--help"))
             (outcome/help (vec)))))

(deftest version-becomes-the-version-outcome
  (assert (= (parse-texts (vec "-V"))
             (outcome/version (str "1.0.0")))))

(deftest a-scan-error-becomes-a-usage-error
  (assert (= (parse-texts (vec "--prot"))
             (usage-error (cli-error/unknown-option (str "--prot"))))))

(deftest a-resolve-error-becomes-a-usage-error
  (assert (= (parse-texts (vec "one" "two"))
             (usage-error (cli-error/unexpected-argument (str "two"))))))

(deftest a-group-parse-records-the-command-path
  (assert (= (match (parse-with (site-spec)
                                (no-environment)
                                (vec "page" "list"))
               ((parsed found) (some (clone (:path found))))
               (_ none))
             (some (vec (str "page") (str "list"))))))

(deftest help-for-a-command-carries-its-path
  (assert (= (parse-with (site-spec)
                         (no-environment)
                         (vec "build" "--help"))
             (outcome/help (vec (str "build"))))))

(deftest a-resolve-error-carries-the-command-path
  (assert (= (parse-with (site-spec)
                         (no-environment)
                         (vec "build" "a" "b"))
             (outcome/usage-error (->usage-failure :path (vec (str "build"))
                                                   :error (cli-error/unexpected-argument
                                                            (str "b")))))))

(deftest help-needs-no-required-option
  (assert (= (parse-with (spec-with-token)
                         (no-environment)
                         (vec "--help"))
             (outcome/help (vec)))))
