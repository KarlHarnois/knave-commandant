(use knave-commandant defcli defcommand parse-args)

(defcommand build "Builds the site into a folder."
  (root string
        :default "."
        :about "The folder that holds the pages")
  (:drafts switch
           :short d
           :about "Builds the draft pages too"))

(defcommand serve "Serves the built site."
  (:port u16
         :short p
         :default 8000
         :env "SITE_PORT"
         :about "The port to listen on"))

(defcommand deploy "Uploads the built site."
  (:token string
          :required true
          :env "SITE_TOKEN"
          :about "The token of the host"))

(defcommand page-add "Adds a page."
  (title string :about "The title of the page")
  (:tags (vec string)
         :short t
         :delimiter ","
         :about "Tags the page, as in `--tags news,release`")
  (:body string
         :conflicts-with body-file
         :about "The text of the page")
  (:body-file string
              :about "Reads the text of the page from a file"))

(defcommand page-list "Lists the pages."
  (filter (option string)
          :about "Lists only the pages whose title holds it"))

(defcommand page-remove "Removes pages."
  (titles (vec string)
          :required true
          :about "The titles of the pages to remove"))

(defcli page "Manages the pages."
  (commands (add page-add)
            (list page-list)
            (remove page-remove)))

(defcli site "Builds and serves a static site."
  :version "1.4.0"
  (:verbose count :short v :about "Logs more with each -v")
  (commands build serve deploy page))

(defn main () (prn (parse-args site)))
