(use knave-commandant defcli defcommand run-command)

(defcommand build "Builds the site into a folder."
  (root string
        :default "."
        :about "The folder that holds the pages")
  (:drafts switch
           :short d
           :about "Builds the draft pages too"))

(defcommand serve "Serves the built site."
  (:port u16
         :short p
         :default 8000
         :env "SITE_PORT"
         :about "The port to listen on"))

(defcommand deploy "Uploads the built site."
  (:token string
          :required true
          :env "SITE_TOKEN"
          :about "The token of the host"))

(defcommand page-add "Adds a page."
  (title string :about "The title of the page"))

(defcommand page-list "Lists the pages.")

(defcli page "Manages the pages."
  (commands (add page-add) (list page-list)))

(defcli site "Builds and serves a static site."
  :version "1.4.0"
  (:verbose count :short v :about "Logs more, once per -v")
  (commands build serve deploy page))

(defn main () (prn (run-command site)))
