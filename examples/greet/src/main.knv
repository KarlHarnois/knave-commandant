(use knave-commandant defcommand error->message exit-early
                      parse-args-from process-env
                      stop-reason switch-state)

(defcommand greet "Greets someone."
  :version "1.0.0"
  (who string :about "Who to greet")
  (:loud switch :short l :about "Greets in capitals"))

(defn main ()
  (match (parse-args-from greet (process-env) (command-line-args))
    ((ok options) (println (greeting options)))
    ((err stop) (exit-early (in-one-line stop)))))

(defn in-one-line (stop)
  (match (:reason stop)
    ((stop-reason/usage failure)
     (assoc stop
            :text (str "greet: "
                       (error->message (ref (:error failure))))))
    (_ stop)))

(defn greeting (options)
  (voiced (:loud options)
          (str "Hello, " (:who options) "!")))

(defn voiced (loud text)
  (match loud
    (on (upper-case (as-str text)))
    (off text)))
