(use knave-commandant defchoice defcommand run-command)

(defchoice log-format text json)

(defstruct header
  :name string
  :value string)

(def header-separator ":")

(defn text->header (text)
  (let (parts (collect (split text header-separator)))
    (if (< (len parts) 2)
      (err (some (str "a header is written `name:value`")))
      (ok (->header :name (str (at parts 0))
                    :value (value-after (ref parts)))))))

(defn value-after (parts)
  (join (collect (map (range 1 (len parts))
                   (fn (index) (str (at parts index)))))
        header-separator))

(defcommand serve "Serves a folder over HTTP."
  :version "1.0.0"
  (root string
        :default "."
        :value-name dir
        :about "The folder to serve")
  (:port u16
         :short p
         :default 8000
         :env "SERVE_PORT"
         :about "The port to listen on")
  (:open switch
         :short o
         :about "Opens the browser once the server starts")
  (:color switch :initial on :about "Colors the log")
  (:verbose count :short v :about "Logs more with each -v")
  (:format log-format
           :default text
           :env ("SERVE_FORMAT" "LOG_FORMAT")
           :about "How to print each request")
  (:header (vec header)
           :parse text->header
           :short H
           :value-name "name:value"
           :about "Adds a header to each response")
  (:name string :about "Names the server in its log"))

(defn main ()
  (let (options (run-command serve))
    (prn options)))
