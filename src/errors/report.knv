(module
  "Writes a usage error: the problem, a tip when a known name is close, the usage line of the command it happened in, and where to find help. A group run without a command gets its help page.")

(use spec/commands spec-at subcommand-names)

(use errors/cli-error cli-error error->message
                      usage-failure)

(use help/page spec->help spec->usage)
(use scan/tokens assignment)
(use spec/builtins builtin-options-of)
(use spec/shapes command-spec long-names long-prefix)
(use errors/suggest closest-name)

(export error-report failure-report)

(def part-break "\n\n")

(type failure-report
  (fn ((ref command-spec) (ref usage-failure) int)
    string))

(defn failure-report (root failure width)
  (let (spec (unwrap-or (spec-at root (ref (:path failure)))
                        (clone root)))
    (match (:error failure)
      (cli-error/missing-command (spec->help (ref spec) width))
      (_ (error-report (ref spec) (ref (:error failure)))))))

(defn error-report (spec failure)
  (let (parts (vec (str "error: " (error->message failure))))
    (push-tip! (mut parts) spec failure)
    (push! parts (str "Usage: " (spec->usage spec)))
    (push! parts
           (str "For more information, try `" (:name spec) " --help`."))
    (join parts part-break)))

(defn push-tip! (parts spec failure)
  (match (tip spec failure)
    ((some text) (push! parts text))
    (none (do))))

(defn tip (spec failure)
  (match failure
    ((unknown-option written)
     (option-tip spec (as-str written)))
    ((unknown-command written)
     (command-tip spec (as-str written)))
    (_ none)))

(defn command-tip (spec written)
  (map-some (closest-name written (ref (subcommand-names spec)))
    (fn (name)
      (str "  tip: a similar command exists: `" name "`"))))

(defn option-tip (spec written)
  (map-some (closest-long spec written)
    (fn (name)
      (str "  tip: a similar option exists: `" long-prefix
           name "`"))))

(defn closest-long (spec written)
  (if (starts-with? written long-prefix)
    (closest-name (as-str (long-name-in written))
                  (ref (known-longs spec)))
    none))

(defn long-name-in (written)
  (let (after-prefix (subs written (len long-prefix) (len written)))
    (str (at (collect (split after-prefix assignment)) 0))))

(defn known-longs (spec)
  (let (names (long-names spec))
    (for-each (builtin-options-of spec)
      (fn (builtin)
        (push! names (clone (:name builtin)))))
    names))
