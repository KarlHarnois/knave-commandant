(module
  "Names each way a command line can break the rules of its command.")

(use spec/shapes name->placeholder)

(export ->invalid-text ->option-conflict ->usage-failure
        cli-error error->message invalid-text
        option-conflict usage-failure)

(defstruct usage-failure
  :path (vec string)
  :error cli-error)

(defenum cli-error
  (unknown-option string)
  (missing-value string)
  (unexpected-value string)
  (repeated-option string)
  (unexpected-arg string)
  (missing-arg string)
  (missing-option string)
  (unknown-command string)
  missing-command
  (invalid-value invalid-text)
  (conflicting-options option-conflict)
  (unsupported-shell string))

(defstruct invalid-text
  :written string
  :text string
  :why (option string))

(defstruct option-conflict
  :written string
  :other string)

(defn error->message (failure)
  (match failure
    ((unknown-option written)
     (str "unknown option `" written "`"))
    ((missing-value written)
     (str "option `" written "` needs a value"))
    ((unexpected-value written)
     (str "option `" written "` takes no value"))
    ((repeated-option written)
     (str "option `" written "` is given more than once"))
    ((unexpected-arg written)
     (str "unexpected argument `" written "`"))
    ((missing-arg name)
     (str "missing argument <"
          (name->placeholder (as-str name))
          ">"))
    ((unknown-command written)
     (str "unknown command `" written "`"))
    (missing-command (str "a command is required"))
    ((missing-option written)
     (str "option `" written "` is required"))
    ((invalid-value invalid)
     (str "invalid value `"
          (:text invalid)
          "` for `"
          (:written invalid)
          "`"
          (explained (:why invalid))))
    ((conflicting-options conflict)
     (str "option `"
          (:written conflict)
          "` cannot be used with `"
          (:other conflict)
          "`"))
    ((unsupported-shell shell)
     (str "no completion for the shell `" shell
          "`, only for bash"))))

(defn explained (why)
  (match why
    ((some reason) (str ": " reason))
    (none (str))))
