(module
  "Names each way a command line can break the rules of its command.")

(export ->invalid-text cli-error error->message
        invalid-text)

(defenum cli-error
  (unknown-option string)
  (missing-value string)
  (unexpected-value string)
  (repeated-option string)
  (unexpected-argument string)
  (missing-argument string)
  (missing-option string)
  (invalid-value invalid-text))

(defstruct invalid-text
  :written string
  :text string)

(defn error->message (failure)
  (match failure
    ((unknown-option written)
     (str "unknown option `" written "`"))
    ((missing-value written)
     (str "option `" written "` needs a value"))
    ((unexpected-value written)
     (str "option `" written "` takes no value"))
    ((repeated-option written)
     (str "option `" written "` is given more than once"))
    ((unexpected-argument written)
     (str "unexpected argument `" written "`"))
    ((missing-argument name)
     (str "missing argument <" name ">"))
    ((missing-option written)
     (str "option `" written "` is required"))
    ((invalid-value invalid)
     (str "invalid value `"
          (:text invalid)
          "` for `"
          (:written invalid)
          "`"))))
