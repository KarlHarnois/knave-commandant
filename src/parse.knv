(module
  "Parses a command line against a command's spec, as a pure function of the spec, the environment and the words.")

(use environment environment)

(use errors/cli-error ->usage-failure cli-error
                      usage-failure)

(use values/matches matches)
(use resolve/matches-of resolve)
(use spec/shapes command-spec)
(use scan/walk finished-scan scan-end scan-tokens)
(use scan/tokens words->tokens)

(export matches->typed outcome parse parse-into)

(defenum outcome
  (parsed matches)
  (help (vec string))
  (version string)
  (usage-error usage-failure))

(defn parse (spec environment words)
  (match (scan-tokens spec (ref (words->tokens words)))
    ((ok end) (scan-end->outcome environment end))
    ((err failure) (outcome/usage-error failure))))

(type parse-into
  (where (t)
    (fn ((ref command-spec)
         (ref environment)
         (ref (vec string))
         (fn ((ref matches))
           (result t cli-error)))
      (result t outcome))))

(defn parse-into (spec environment words convert)
  (match (parse spec environment words)
    ((parsed found)
     (map-err (matches->typed (ref found) convert)
       (fn (failure) (outcome/usage-error failure))))
    (other (err other))))

(type matches->typed
  (where (t)
    (fn ((ref matches)
         (fn ((ref matches))
           (result t cli-error)))
      (result t usage-failure))))

(defn matches->typed (found convert)
  (map-err (convert found)
    (fn (failure)
      (->usage-failure :path (clone (:path found)) :error failure))))

(defn scan-end->outcome (environment end)
  (match end
    ((scanned finished)
     (finished->outcome environment finished))
    ((help path) (outcome/help path))
    ((version text) (outcome/version text))))

(type finished->outcome
  (fn ((ref environment) finished-scan) outcome))

(defn finished->outcome (environment finished)
  (let-match ((finished-scan scan spec) finished)
    (match (resolve (ref spec) environment (ref scan))
      ((ok found) (outcome/parsed found))
      ((err failure)
       (outcome/usage-error (->usage-failure :path (clone (:path scan))
                                             :error failure))))))
