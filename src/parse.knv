(module
  "Parses a command line against a command's spec, as a pure function of the spec, the environment and the words.")

(use complete/request completion-request
                      completion-request-of)

(use env env)

(use errors/cli-error ->usage-failure cli-error
                      usage-failure)

(use values/matches matches)
(use resolve/matches-of resolve)
(use scan/walk finished-scan scan-end scan-tokens)
(use scan/tokens words->tokens)

(export outcome parse)

(defenum outcome
  (parsed matches)
  (help (vec string))
  (version string)
  (usage-error usage-failure)
  (completion string))

(defn parse (spec env words)
  (match (completion-request-of spec env words)
    (absent (parse-words spec env words))
    ((answered reply) (outcome/completion reply))
    ((unsupported shell)
     (outcome/usage-error (->usage-failure :path (vec)
                                           :error (cli-error/unsupported-shell
                                                    shell))))))

(defn parse-words (spec env words)
  (match (scan-tokens spec (ref (words->tokens words)))
    ((ok end) (scan-end->outcome env end))
    ((err failure) (outcome/usage-error failure))))

(defn scan-end->outcome (env end)
  (match end
    ((scanned finished) (finished->outcome env finished))
    ((help path) (outcome/help path))
    ((version text) (outcome/version text))))

(type finished->outcome
  (fn ((ref env) finished-scan) outcome))

(defn finished->outcome (env finished)
  (let-match ((finished-scan scan spec) finished)
    (match (resolve (ref spec) env (ref scan))
      ((ok found) (outcome/parsed found))
      ((err failure)
       (outcome/usage-error (->usage-failure :path (clone (:path scan))
                                             :error failure))))))
