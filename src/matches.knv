(module
  "Holds what a parse found, and reads the text of each argument and the value of each option.")

(use spec switch-state)

(export ->argument-match ->matches ->option-match
        argument-match argument-text command-at many-texts
        matched-value matches one-text option-match
        option-value read-count read-switch shifted)

(defstruct matches
  :path (vec string)
  :arguments (vec argument-match)
  :options (vec option-match))

(defstruct argument-match
  :name string
  :value string)

(defstruct option-match
  :long string
  :value matched-value)

(defenum matched-value
  (switch switch-state)
  (count int)
  (one (option string))
  (many (vec string)))

(type argument-text
  (fn ((ref matches) (ref str))
    (option (ref string))))

(defn argument-text (matches name)
  (map-some (find (iter (:arguments matches))
              (fn (found)
                (= (as-str (:name found)) name)))
            (fn (found) (:value found))))

(defn read-switch (found long)
  (match (option-value found long)
    ((some (switch state)) (deref state))
    (_ switch-state/off)))

(defn read-count (found long)
  (match (option-value found long)
    ((some (count total)) (deref total))
    (_ 0)))

(defn one-text (found long)
  (match (option-value found long)
    ((some (one text)) (clone text))
    (_ none)))

(defn many-texts (found long)
  (match (option-value found long)
    ((some (many texts)) (clone texts))
    (_ (vec))))

(type option-value
  (fn ((ref matches) (ref str))
    (option (ref matched-value))))

(defn option-value (matches long)
  (map-some (find (iter (:options matches))
              (fn (found)
                (= (as-str (:long found)) long)))
            (fn (found) (:value found))))

(type command-at
  (fn ((ref matches)) string))

(defn command-at (found)
  (unwrap-or (map-some (first (:path found)) clone)
             (str)))

(type shifted
  (fn ((ref matches)) matches))

(defn shifted (found)
  (assoc (clone found)
         :path (collect (map (range 1 (len (:path found)))
                          (fn (index)
                            (clone (at (:path found) index)))))))
