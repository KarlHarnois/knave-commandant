(module
  "Checks that a command's arguments come in an order a command line can fill: required ones first, at most one repeated argument, and only required ones after it.")

(use spec argument-presence argument-spec command-spec
          repeated? required?)

(export argument-order order-error order-error->message)

(defenum order-error
  (second-repeated string)
  (after-optional string)
  (after-repeated string))

(defn argument-order (spec) (order-from spec 0))

(defn order-error->message (failure)
  (match failure
    ((second-repeated name)
     (str "argument <" name
          "> repeats, but only one argument can"))
    ((after-optional name)
     (str "argument <" name
          "> must come before every optional argument"))
    ((after-repeated name)
     (str "argument <" name
          "> follows a repeated argument, so it must be required"))))

(type order-from
  (fn ((ref command-spec) int)
    (result unit order-error)))

(defn order-from (spec index)
  (if (>= index (len (:arguments spec)))
    (ok (do))
    (order-at spec index)))

(defn order-at (spec index)
  (match (violation-at spec index)
    ((some failure) (err failure))
    (none (order-from spec (inc index)))))

(type violation-at
  (fn ((ref command-spec) int)
    (option order-error)))

(defn violation-at (spec index)
  (let (argument (at (:arguments spec) index)
        name (clone (:name argument)))
    (cond
      ((and (repeated? argument) (earlier? spec index repeated?))
       (some (order-error/second-repeated name)))
      ((and (must-be-given? argument)
            (earlier? spec index optional?))
       (some (order-error/after-optional name)))
      ((and (earlier? spec index repeated?)
            (not (single-required? argument)))
       (some (order-error/after-repeated name)))
      (else none))))

(type earlier?
  (fn ((ref command-spec)
       int
       (fn ((ref argument-spec)) bool))
    bool))

(defn earlier? (spec index test)
  (any? (range 0 index)
    (fn (earlier)
      (test (at (:arguments spec) earlier)))))

(defn must-be-given? (argument)
  (or (required? argument) (repeated? argument)))

(type optional?
  (fn ((ref argument-spec)) bool))

(defn optional? (argument)
  (match (:presence argument)
    (argument-presence/optional true)
    ((argument-presence/defaulted _) true)
    (_ false)))

(type single-required?
  (fn ((ref argument-spec)) bool))

(defn single-required? (argument)
  (match (:presence argument)
    (argument-presence/required true)
    (_ false)))
