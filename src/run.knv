(module
  "Runs a command against the process: reads its words and environment, and on an early exit prints its text and stops. It is the only module that touches the process.")

(use command-line early-exit output-stream parse-line-into)
(use env ->env ->env-var)
(use errors/cli-error cli-error)
(use spec/shapes command-spec)
(use values/matches matches)

(export exit-early pairs->env process-env run run-with)

(def exit-with
  (rust "std::process::exit({0} as i32)"
    (where (t) (fn (int) t))))

(def process-env-vars
  (rust "std::env::vars().collect::<Vec<(String, String)>>()"
    (fn () (vec (pair string string)))))

(defn run (spec)
  (run-with spec
    (fn (found) (ok (clone found)))))

(type run-with
  (where (t)
    (fn ((ref command-spec)
         (fn ((ref matches))
           (result t cli-error)))
      t)))

(defn run-with (spec convert)
  (match (parse-line-into spec
                          (ref (process-env))
                          (ref (command-line-args))
                          convert)
    ((ok value) value)
    ((err stop) (exit-early stop))))

(type exit-early
  (where (t) (fn (early-exit) t)))

(defn exit-early (stop)
  (print-on (:stream stop)
            (as-str (:text stop)))
  (exit-with (:code stop)))

(defn print-on (stream text)
  (match stream
    (standard-output (println text))
    (standard-error (eprintln text))))

(defn process-env ()
  (pairs->env (ref (process-env-vars))))

(defn pairs->env (pairs)
  (->env :vars (collect (map (iter pairs) pair->env-var))))

(defn pair->env-var (entry)
  (let-match ((pair name value) entry)
    (->env-var :name (clone name) :value (clone value))))
