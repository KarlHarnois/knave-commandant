(module
  "Runs a command against the process: reads its words and environment, answers help and version, and stops on a usage error or a broken spec.")

(use environment ->environment ->variable)
(use spec/commands spec-at)
(use errors/report failure-report)
(use help/page spec->help)
(use values/matches matches)
(use parse matches->typed outcome parse)
(use spec/shapes command-spec)
(use help/terminal terminal-width)
(use spec/spec-error spec-error->message)
(use spec/validate validate-spec)
(use errors/cli-error ->usage-failure cli-error)

(export command->response process-environment response run
        run-with)

(def usage-exit-code 2)

(def broken-spec-exit-code 70)

(def exit-with
  (rust "std::process::exit({0} as i32)"
    (where (t) (fn (int) t))))

(def process-variables
  (rust "std::env::vars().collect::<Vec<(String, String)>>()"
    (fn () (vec (pair string string)))))

(defenum response
  (proceed matches)
  (reply string)
  (refuse string)
  (broken string))

(type run-with
  (where (t)
    (fn ((ref command-spec)
         (fn ((ref matches))
           (result t cli-error)))
      t)))

(defn run-with (spec convert)
  (let (found (run spec))
    (match (matches->typed (ref found) convert)
      ((ok value) value)
      ((err failure) (refuse-typed spec failure)))))

(defn run (spec)
  (respond (command->response spec
                              (process-environment)
                              (command-line-args))))

(defn command->response (spec environment words)
  (match (validate-spec spec)
    ((ok _)
     (outcome->response spec
                        (parse spec (ref environment) (ref words))
                        (terminal-width (ref environment))))
    ((err failure)
     (response/broken (str "invalid command spec: "
                           (spec-error->message failure))))))

(defn refuse-typed (spec failure)
  (eprintln (failure-report spec (ref failure)))
  (exit-with usage-exit-code))

(defn outcome->response (spec outcome width)
  (match outcome
    ((parsed found) (response/proceed found))
    ((help path)
     (response/reply (help-at spec (ref path) width)))
    ((version text)
     (response/reply (str (:name spec) " " text)))
    ((usage-error failure)
     (response/refuse (failure-report spec (ref failure))))
    ((completion reply) (response/reply reply))))

(defn help-at (spec path width)
  (spec->help (ref (unwrap-or (spec-at spec path) (clone spec)))
              width))

(defn respond (response)
  (match response
    ((proceed found) found)
    ((reply text) (println text) (exit-with 0))
    ((refuse text) (eprintln text) (exit-with usage-exit-code))
    ((broken text)
     (eprintln text)
     (exit-with broken-spec-exit-code))))

(defn process-environment ()
  (->environment :variables (collect (map (iter (process-variables))
                                          pair->variable))))

(defn pair->variable (entry)
  (let-match ((pair name value) entry)
    (->variable :name (clone name) :value (clone value))))
