(module
  "Walks the tokens of a command line, reading each with the spec in effect, and follows each subcommand it names.")

(use spec/commands subcommands?)
(use errors/cli-error ->usage-failure cli-error)
(use scan/hits stop)
(use scan/items item token->items)
(use scan/options scan-assignment! scan-flag!)
(use scan/state ->scan scan step)
(use spec/shapes command-spec)
(use scan/tokens token)
(use scan/words scan-word!)

(export ->finished-scan finished-scan scan-end scan-tokens)

(defenum scan-end
  (scanned finished-scan)
  (help (vec string))
  (version string))

(defstruct finished-scan
  :scan scan
  :spec command-spec)

(defn scan-tokens (spec tokens)
  (let (scan (->scan :path (vec)
                     :positionals (vec)
                     :occurrences (vec)))
    (match (walk! spec tokens (mut scan))
      ((ok (pair stop final))
       (ok (stop->scan-end stop scan final)))
      ((err failure)
       (err (->usage-failure :path (clone (:path scan)) :error failure))))))

(defn stop->scan-end (stop scan final)
  (match stop
    (finished (scan-end/scanned (->finished-scan :scan scan :spec final)))
    (help-asked (scan-end/help (clone (:path scan))))
    ((version-asked text) (scan-end/version text))))

(defn walk! (root tokens scan)
  (loop (index 0
         spec (clone root))
    (match (scan-at! (ref spec) tokens index scan)
      ((ok (advance next)) (recur next spec))
      ((ok (descend subcommand)) (recur (inc index) subcommand))
      ((ok (halt stop)) (ok (pair stop spec)))
      ((err failure) (err failure)))))

(defn scan-at! (spec tokens index scan)
  (match (get tokens index)
    ((some token)
     (scan-token-items! spec tokens index scan
                        (token->items spec token)))
    (none (end-of-line spec))))

(defn end-of-line (spec)
  (if (subcommands? spec)
    (err cli-error/missing-command)
    (ok (step/halt stop/finished))))

(type scan-token-items!
  (fn ((ref command-spec)
       (ref (vec token))
       int
       (mut scan)
       (vec item))
    (result step cli-error)))

(defn scan-token-items! (spec tokens index scan items)
  (reduce (iter items) (ok (step/advance (inc index)))
    (fn (so-far item)
      (next-item-step! spec tokens index scan item so-far))))

(type next-item-step!
  (fn ((ref command-spec)
       (ref (vec token))
       int
       (mut scan)
       (ref item)
       (result step cli-error))
    (result step cli-error)))

(defn next-item-step! (spec tokens index scan item so-far)
  (match so-far
    ((ok (advance _)) (scan-item! spec tokens index scan item))
    (stopped stopped)))

(type scan-item!
  (fn ((ref command-spec)
       (ref (vec token))
       int
       (mut scan)
       (ref item))
    (result step cli-error)))

(defn scan-item! (spec tokens index scan item)
  (match item
    ((flag flag) (scan-flag! spec tokens index scan flag))
    ((flag-with-value flag value)
     (scan-assignment! spec index scan flag value))
    (options-end (ok (step/advance (inc index))))
    ((word text) (scan-word! spec tokens index scan text))))
