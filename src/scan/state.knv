(module
  "Holds what a scan has found so far, and how far it has read.")

(use errors/cli-error cli-error)
(use scan/hits stop)
(use spec/shapes command-spec option-spec)

(export ->scan occurrence occurrence-value record! scan
        step)

(defstruct scan
  :path (vec string)
  :positionals (vec string)
  :occurrences (vec occurrence))

(defstruct occurrence
  :long string
  :written string
  :value occurrence-value)

(defenum occurrence-value
  present
  negated
  (text string))

(defenum step
  (advance int)
  (descend command-spec)
  (halt stop))

(type record!
  (fn ((mut scan) option-spec string occurrence-value int)
    (result step cli-error)))

(defn record! (scan option written value next)
  (push! (:occurrences scan)
         (->occurrence :long (clone (:long option))
                       :written written
                       :value value))
  (ok (step/advance next)))
