(module
  "Writes how the help page and the usage line show an argument or an option, with its value in capitals.")

(use help/placeholders shown-placeholder)

(use spec/shapes arg-spec long-prefix name->placeholder
                 repetition required? switch-state
                 value-kind)

(export arg-term option-term required-option-term)

(def no-short "    ")

(type arg-term
  (fn ((ref arg-spec)) string))

(defn arg-term (arg)
  (let (shown (shown-placeholder (as-str (:name arg))
                                 (ref (:value-name arg))
                                 (ref (:choices arg))))
    (str (bracketed arg shown)
         (repeat-mark (:repeats arg)))))

(type bracketed
  (fn ((ref arg-spec) string) string))

(defn bracketed (arg shown)
  (if (required? arg)
    (str "<" shown ">")
    (str "[" shown "]")))

(defn repeat-mark (repeats)
  (match repeats
    (repeated (str "..."))
    (once (str))))

(defn option-term (option)
  (str (short-part (:short option))
       long-prefix
       (negation-mark (:value option))
       (:long option)
       (value-part (as-str (:long option))
                   (:value option))))

(defn required-option-term (option)
  (str long-prefix
       (:long option)
       (value-part (as-str (:long option))
                   (:value option))))

(defn short-part (short)
  (match short
    ((some character) (str "-" character ", "))
    (none (str no-short))))

(defn negation-mark (value)
  (match value
    ((switch slot) (initial-mark (:initial slot)))
    (_ (str))))

(defn initial-mark (initial)
  (match initial
    (on (str "[no-]"))
    (off (str))))

(defn value-part (long value)
  (match value
    ((switch _) (str))
    (count (str "..."))
    ((one slot) (bracketed-value (slot-placeholder long slot)))
    ((many slot) (list-term slot))))

(defn list-term (slot)
  (match (:delimiter slot)
    ((some separator)
     (str (value-term (:placeholder slot)) separator "..."))
    (none (str (value-term (:placeholder slot)) "..."))))

(defn slot-placeholder (long slot)
  (shown-placeholder long
                     (ref (:value-name slot))
                     (ref (:choices slot))))

(defn value-term (name)
  (bracketed-value (name->placeholder (as-str name))))

(defn bracketed-value (shown) (str " <" shown ">"))
