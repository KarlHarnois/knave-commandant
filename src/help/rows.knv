(module
  "Describes each argument and option of a command as one row of its help page.")

(use spec/shapes command-spec presence value-kind)
(use help/placeholders choices-listed?)
(use help/terms arg-term option-term)

(use spec/builtins builtin-options-of help-command
                   help-command-about)

(export ->help-row arg-rows command-rows help-row
        option-rows)

(defstruct help-row
  :term string
  :description string)

(defn arg-rows (spec)
  (collect (map (iter (:args spec)) arg-row)))

(type option-rows
  (fn ((ref command-spec)) (vec help-row)))

(defn option-rows (spec)
  (let (rows (collect (map (iter (:options spec)) option-row)))
    (for-each (builtin-options-of spec)
      (fn (builtin)
        (push! rows (builtin-row builtin))))
    rows))

(defn builtin-row (builtin)
  (->help-row :term (str "-" (:letter builtin) ", --" (:name builtin))
              :description (clone (:summary builtin))))

(defn command-rows (spec)
  (let (rows (collect (map (iter (:subcommands spec)) command-row)))
    (when (not (empty? rows))
      (push! rows
             (->help-row :term (str help-command)
                         :description (str help-command-about))))
    rows))

(defn command-row (subcommand)
  (->help-row :term (clone (:name subcommand))
              :description (clone (:about subcommand))))

(defn arg-row (arg)
  (->help-row :term (arg-term arg)
              :description (str (:about arg)
                                (arg-default-note (:presence arg)))))

(defn arg-default-note (presence)
  (match presence
    ((presence/defaulted text) (default-note text))
    (_ (str))))

(defn option-row (option)
  (->help-row :term (option-term option)
              :description (str (:about option)
                                (value-notes (:value option)))))

(defn value-notes (value)
  (match value
    ((switch slot) (env-note (:env slot)))
    ((one slot)
     (str (slot-default-note slot)
          (choices-note slot)
          (env-note (:env slot))))
    (_ (str))))

(defn slot-default-note (slot)
  (match (:presence slot)
    ((presence/defaulted text) (default-note text))
    (_ (str))))

(defn choices-note (slot)
  (if (or (empty? (:choices slot))
          (choices-listed? (ref (:value-name slot))
                           (ref (:choices slot))))
    (str)
    (str " [possible values: " (join (:choices slot) ", ") "]")))

(defn default-note (text) (str " [default: " text "]"))

(defn env-note (names)
  (if (empty? names)
    (str)
    (str " [env: " (join names ", ") "]")))
