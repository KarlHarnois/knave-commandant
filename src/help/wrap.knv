(module
  "Breaks a text into lines of at most a given width, between words, keeping the text's own line breaks.")

(export wrap)

(def word-separator " ")

(defstruct wrapping
  :lines (vec string)
  :current string)

(defn wrap (text width)
  (let-match ((wrapping wrapped _) (reduce
                                     (lines text)
                                     (->wrapping :lines (vec) :current (str))
                                     (fn (wrapping line)
                                       (end-line
                                         (wrap-words wrapping line width)))))
    wrapped))

(defn wrap-words (wrapping line width)
  (reduce (filter (split line word-separator) word?) wrapping
    (fn (wrapping word) (add-word wrapping word width))))

(defn end-line (wrapping)
  (let-match ((wrapping lines current) wrapping)
    (->wrapping :lines (appended lines current) :current (str))))

(defn word? (part)
  (not (empty? (deref part))))

(defn add-word (wrapping word width)
  (let-match ((wrapping lines current) wrapping)
    (cond
      ((empty? current)
       (->wrapping :lines lines :current (str word)))
      ((fits? (as-str current) word width)
       (->wrapping :lines lines
                   :current (str current word-separator word)))
      (else (->wrapping :lines (appended lines current)
                        :current (str word))))))

(defn fits? (current word width)
  (<= (+ (len current)
         (len word-separator)
         (len word))
      width))

(defn appended (lines line)
  (let (all lines) (push! all line) all))
