(use lib ->argument-spec ->command-spec ->environment
         ->option-spec ->value-slot argument-presence parse
         switch-state value-kind)

(defn main ()
  (prn (parse (ref (demo-spec))
              (ref (->environment :variables (vec)))
              (ref (command-line-args)))))

(defn demo-spec ()
  (->command-spec :name (str "demo")
                  :about (str "Prints how a command line parses.")
                  :version (some (str "0.1.0"))
                  :arguments (vec (->argument-spec :name (str "path")
                                                   :about (str "A path")
                                                   :presence (argument-presence/defaulted
                                                               (str "."))))
                  :options (vec (->option-spec
                                  :long (str "name")
                                  :short (some (char "n"))
                                  :about (str "A name")
                                  :value (value-kind/one (->value-slot
                                                           :placeholder (str "name")
                                                           :default none))
                                  :env (vec))
                                (->option-spec :long (str "loud")
                                               :short (some (char "l"))
                                               :about (str "Prints loudly")
                                               :value (value-kind/switch
                                                        switch-state/off)
                                               :env (vec)))))
