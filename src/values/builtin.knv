(module
  "Reads each built-in type a parameter can take, such as `string`, `bool` and the number types, from its text, and says what it expected when it cannot.")

(export bool-names text->bool text->char text->float
        text->i32 text->int text->string text->u16 text->u32
        text->u64 text->u8 text->usize)

(type text->string
  (fn ((ref str))
    (result string (option string))))

(defn text->string (text)
  (ok (str text)))

(defn bool-names ()
  (vec (str "true") (str "false")))

(type text->bool
  (fn ((ref str))
    (result bool (option string))))

(defn text->bool (text) (parsed text "true or false"))

(type text->char
  (fn ((ref str))
    (result char (option string))))

(defn text->char (text) (parsed text "one character"))

(type text->int
  (fn ((ref str))
    (result int (option string))))

(defn text->int (text)
  (parsed text
          "a whole number from -9223372036854775808 to 9223372036854775807"))

(type text->i32
  (fn ((ref str))
    (result i32 (option string))))

(defn text->i32 (text)
  (parsed text
          "a whole number from -2147483648 to 2147483647"))

(type text->u8
  (fn ((ref str))
    (result u8 (option string))))

(defn text->u8 (text)
  (parsed text "a whole number from 0 to 255"))

(type text->u16
  (fn ((ref str))
    (result u16 (option string))))

(defn text->u16 (text)
  (parsed text "a whole number from 0 to 65535"))

(type text->u32
  (fn ((ref str))
    (result u32 (option string))))

(defn text->u32 (text)
  (parsed text "a whole number from 0 to 4294967295"))

(type text->u64
  (fn ((ref str))
    (result u64 (option string))))

(defn text->u64 (text)
  (parsed text
          "a whole number from 0 to 18446744073709551615"))

(type text->usize
  (fn ((ref str))
    (result usize (option string))))

(defn text->usize (text)
  (parsed text
          "a whole number, 0 or more, within this machine's range"))

(type text->float
  (fn ((ref str))
    (result float (option string))))

(defn text->float (text) (parsed text "a number"))

(type parsed
  (where ((t from-str))
    (fn ((ref str) (ref str))
      (result t (option string)))))

(defn parsed (text expected)
  (match (parse text)
    ((ok value) (ok value))
    ((err _) (err (some (str "expected " expected))))))
