(module
  "Turns the text of a matched argument or option into a typed value, through the `cli-value` trait.")

(use errors/cli-error ->invalid-text cli-error)
(use spec/shapes long-flag name->placeholder)

(use values/matches argument-text argument-texts many-texts
                    matches one-text)

(export cli-value from-text parsed read-argument
        read-arguments read-many read-option read-optional
        read-optional-argument value-names)

(deftrait cli-value
  (from-text
    (fn ((ref str)) (option self)))

  (value-names
    (fn ((ref (option self))) (vec string))))

(type read-argument
  (where ((t cli-value))
    (fn ((ref matches) (ref str))
      (result t cli-error))))

(defn read-argument (found name)
  (match (argument-text found name)
    ((some text) (converted text (argument-written name)))
    (none (err (cli-error/missing-argument (str name))))))

(type read-optional-argument
  (where ((t cli-value))
    (fn ((ref matches) (ref str))
      (result (option t) cli-error))))

(defn read-optional-argument (found name)
  (match (argument-text found name)
    ((some text)
     (map-ok (converted text (argument-written name)) some))
    (none (ok none))))

(type read-arguments
  (where ((t cli-value))
    (fn ((ref matches) (ref str))
      (result (vec t) cli-error))))

(defn read-arguments (found name)
  (converted-all (argument-texts found name)
                 (argument-written name)))

(defn argument-written (name)
  (str "<" (name->placeholder name) ">"))

(type read-option
  (where ((t cli-value))
    (fn ((ref matches) (ref str))
      (result t cli-error))))

(defn read-option (found long)
  (match (one-text found long)
    ((some text) (converted (ref text) (long-flag long)))
    (none (err (cli-error/missing-option (long-flag long))))))

(type read-optional
  (where ((t cli-value))
    (fn ((ref matches) (ref str))
      (result (option t) cli-error))))

(defn read-optional (found long)
  (match (one-text found long)
    ((some text)
     (map-ok (converted (ref text) (long-flag long))
             some))
    (none (ok none))))

(type read-many
  (where ((t cli-value))
    (fn ((ref matches) (ref str))
      (result (vec t) cli-error))))

(defn read-many (found long)
  (converted-all (many-texts found long) (long-flag long)))

(type converted-all
  (where ((t cli-value))
    (fn ((vec string) string)
      (result (vec t) cli-error))))

(defn converted-all (texts written)
  (loop (index 0
         values (vec))
    (if (>= index (len texts))
      (ok values)
      (let-try (value (converted (at texts index) (clone written)))
        (recur (inc index) (appended values value))))))

(type converted
  (where ((t cli-value))
    (fn ((ref string) string)
      (result t cli-error))))

(defn converted (text written)
  (ok-or (from-text (as-str text))
         (cli-error/invalid-value (->invalid-text :written written
                                                  :text (clone text)))))

(defn appended (items item)
  (let (all items) (push! all item) all))

(type parsed
  (where ((t from-str))
    (fn ((ref str)) (option t))))

(defn parsed (text)
  (match (parse text)
    ((ok value) (some value))
    ((err _) none)))
