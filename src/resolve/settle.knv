(module
  "Settles each option's value from its flags, then its environment variables, then its default.")

(use resolve/delimited list-texts)
(use env env first-set)

(use values/matches ->option-match matched-value
                    option-match)

(use scan/state occurrence occurrence-value
                occurrences-named)

(use spec/shapes command-spec option-spec presence
                 switch-slot switch-state value-kind
                 value-slot)

(export option-matches)

(def off-texts (vec "" "0" "false" "no" "off"))

(type option-matches
  (fn ((ref command-spec)
       (ref env)
       (ref (vec occurrence)))
    (vec option-match)))

(defn option-matches (spec env occurrences)
  (collect (map (iter (:options spec))
             (fn (option)
               (->option-match :long (clone (:long option))
                               :value (settled-value env
                                                     (occurrences-named
                                                       occurrences
                                                       (as-str (:long option)))
                                                     option))))))

(type settled-value
  (fn ((ref env)
       (vec (ref occurrence))
       (ref option-spec))
    matched-value))

(defn settled-value (env found option)
  (match (:value option)
    ((switch slot)
     (matched-value/switch (switch-from env slot (ref found))))
    (count (matched-value/count (len found)))
    ((one slot)
     (matched-value/one (one-value env (ref found) slot)))
    ((many slot)
     (matched-value/many (list-texts (texts (ref found))
                                     (:delimiter slot))))))

(type switch-from
  (fn ((ref env)
       (ref switch-slot)
       (ref (vec (ref occurrence))))
    switch-state))

(defn switch-from (env slot found)
  (match (last found)
    ((some occurrence) (occurrence->switch (:value occurrence)))
    (none (switch-fallback env slot))))

(defn occurrence->switch (value)
  (match value (negated switch-state/off) (_ switch-state/on)))

(type switch-fallback
  (fn ((ref env) (ref switch-slot))
    switch-state))

(defn switch-fallback (env slot)
  (match (first-set env (:env slot))
    ((some text) (text->switch text))
    (none (:initial slot))))

(defn text->switch (text)
  (if (any? (iter off-texts)
        (fn (off)
          (= (deref off)
             (as-str (lower-case (as-str text))))))
    switch-state/off switch-state/on))

(type one-value
  (fn ((ref env)
       (ref (vec (ref occurrence)))
       (ref value-slot))
    (option string)))

(defn one-value (env found slot)
  (match (first found)
    ((some occurrence) (occurrence-text (:value occurrence)))
    (none (fallback-value env slot))))

(defn fallback-value (env slot)
  (match (first-set env (:env slot))
    ((some value) (some value))
    (none (presence-default (:presence slot)))))

(defn presence-default (presence)
  (match presence
    ((presence/defaulted text) (some (clone text)))
    (_ none)))

(defn occurrence-text (value)
  (match value
    ((text written) (some (clone written)))
    (_ none)))

(type texts
  (fn ((ref (vec (ref occurrence))))
    (vec string)))

(defn texts (found)
  (let (collected (vec))
    (for-each (iter found)
      (fn (occurrence)
        (push-text! (mut collected) (:value occurrence))))
    collected))

(defn push-text! (collected value)
  (match (occurrence-text value)
    ((some text) (push! collected text))
    (none (do))))
