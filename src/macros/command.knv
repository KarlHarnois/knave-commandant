(module
  "Defines `defcommand`, which turns one declaration into a typed struct, its spec, its parse and its run.")

(use prelude/macros header-shape)
(use code empty? symbol-name)
(use errors cli-error)

(use macros/declaration about-of bindings constructor-fields
                        fields named only parameters-of
                        settings-of specs version-form)

(use macros/parameters matches-name)
(use matches matches)
(use run run-with)
(use spec ->command-spec)

(export defcommand run-command)

(defmacro defcommand (name parts ...)
  "Defines a command: a struct with one typed field per parameter, `name-spec`
  and `matches->name`. `(run-command name)` parses the process's command line."
  (let-parts name
             (about-of parts)
             (settings-of parts)
             (parameters-of parts)))

(defmacro run-command (name)
  "Parses the process's command line with the command `name`, defined by
  `defcommand` or `defcli`, and returns its typed struct. It answers help and
  version, and exits with code 2 on a usage error."
  (template (run-with (ref ((unquote (named name "" "-spec"))))
                      (unquote (named name "matches->" "")))))

(header-shape (defcommand name docstring))

(def let-parts
  (fn (name about settings parameters)
    (template (do
                (defstruct (unquote name)
                  (splice (fields parameters)))
                (defn (unquote (named name "" "-spec")) ()
                  (->command-spec
                    :name (str (unquote (symbol-name name)))
                    :about (str (unquote about))
                    :version (unquote (version-form settings))
                    :arguments (vec (splice (specs (only parameters true))))
                    :options (vec (splice (specs (only parameters false))))
                    :subcommands (vec)))
                (type (unquote (named name "matches->" ""))
                  (fn ((ref matches))
                    (result (unquote name) cli-error)))
                (defn (unquote (named name "matches->" "")) ((unquote (matches-name
                                                                        name)))
                  (unquote (converter name parameters)))))))

(def converter
  (fn (name parameters)
    (if (empty? parameters)
      (template (ok ((unquote (named name "->" "")))))
      (template (let-try ((splice (bindings parameters)))
                  (ok ((unquote (named name "->" ""))
                       (splice (constructor-fields parameters)))))))))
