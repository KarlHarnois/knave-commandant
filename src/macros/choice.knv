(module
  "Defines `defchoice`, an enum whose case names are the values an option accepts.")

(use code empty? first list prepend rest string symbol
          symbol-name)

(export defchoice)

(def reader-prefix "text->")

(def names-suffix "-names")

(defmacro defchoice (name cases ...)
  "Defines an enum of unit cases that an option or argument can take by name,
  with `text->name`, which reads a case from its name, and `name-names`, which
  lists the names."
  (template (do
              (defenum (unquote name) (splice cases))
              (defn (unquote (reader-name name)) (text)
                (match text
                  (splice (case-clauses name cases))
                  (_ (err (some (str "expected one of "
                                     (join (unquote (names-call name))
                                           ", ")))))))
              (defn (unquote (names-name name)) ()
                (vec (splice (case-texts cases)))))))

(def reader-name
  (fn (name)
    (symbol name (string reader-prefix (symbol-name name)))))

(def names-name
  (fn (name)
    (symbol name (string (symbol-name name) names-suffix))))

(def names-call
  (fn (name) (list (names-name name))))

(def case-clauses
  (fn (name cases)
    (if (empty? cases)
      (list)
      (prepend (template ((unquote (symbol-name (first cases)))
                          (ok (unquote (case-symbol name (first cases))))))
               (case-clauses name (rest cases))))))

(def case-symbol
  (fn (name case)
    (symbol name
            (string (symbol-name name) "/" (symbol-name case)))))

(def case-texts
  (fn (cases)
    (if (empty? cases)
      (list)
      (prepend (template (str (unquote (symbol-name (first cases)))))
               (case-texts (rest cases))))))
