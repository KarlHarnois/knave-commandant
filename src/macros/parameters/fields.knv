(module
  "Writes the struct field, the local binding and the reader of one `defcommand` parameter.")

(use code first list string symbol)

(use macros/parameters/kinds argument-kind choose kind-count
                             kind-many kind-one
                             kind-optional kind-switch
                             option-kind)

(use macros/parameters/parts always-set? argument?
                             parameter-name parameter-type)

(use values/matches read-count read-switch)
(use spec/shapes switch-state)

(use values/convert read-argument read-arguments read-many
                    read-option read-optional
                    read-optional-argument)

(export matches-name parameter-binding parameter-field
        parameter-reader)

(def parameter-binding
  (fn (parameter)
    (symbol (first parameter) (parameter-name parameter))))

(def parameter-field
  (fn (parameter)
    (list (symbol (first parameter)
                  (string ":" (parameter-name parameter)))
          (field-type parameter))))

(def parameter-reader
  (fn (parameter)
    (if (argument? parameter)
      (argument-reader parameter
                       (matches-name (first parameter))
                       (parameter-name parameter))
      (option-reader parameter
                     (matches-name (first parameter))
                     (parameter-name parameter)))))

(def argument-reader
  (fn (parameter found name)
    (choose (argument-kind parameter)
            (list kind-many
                  (template (read-arguments (unquote found) (unquote name)))
                  kind-optional
                  (template (read-optional-argument (unquote found)
                                                    (unquote name)))
                  kind-one
                  (template (read-argument (unquote found) (unquote name)))))))

(def matches-name
  (fn (anchor) (symbol anchor "command-line-matches")))

(def field-type
  (fn (parameter)
    (if (argument? parameter)
      (parameter-type parameter)
      (option-field-type parameter (parameter-type parameter)))))

(def option-field-type
  (fn (parameter type)
    (choose (option-kind parameter)
            (list kind-switch
                  (quote switch-state)
                  kind-count
                  (quote int)
                  kind-many type kind-one
                  (one-field-type parameter type)))))

(def one-field-type
  (fn (parameter type)
    (if (always-set? parameter)
      type
      (template (option (unquote type))))))

(def option-reader
  (fn (parameter found name)
    (choose (option-kind parameter)
            (list kind-switch
                  (template (ok (read-switch (unquote found) (unquote name))))
                  kind-count
                  (template (ok (read-count (unquote found) (unquote name))))
                  kind-many
                  (template (read-many (unquote found) (unquote name)))
                  kind-one
                  (one-reader parameter found name)))))

(def one-reader
  (fn (parameter found name)
    (if (always-set? parameter)
      (template (read-option (unquote found) (unquote name)))
      (template (read-optional (unquote found) (unquote name))))))
