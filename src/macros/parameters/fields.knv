(module
  "Writes the struct field, the local binding and the reader of one `defcommand` parameter.")

(use code first list string symbol)

(use macros/parameters/kinds arg-kind choose kind-count
                             kind-many kind-one
                             kind-optional kind-switch
                             option-kind)

(use macros/parameters/parts always-set? arg? parameter-name
                             parameter-type)

(use macros/parameters/readers reader-form)
(use values/matches read-count read-switch)
(use spec/shapes switch-state)

(use values/convert read-arg read-args read-many read-option
                    read-optional read-optional-arg)

(export matches-name parameter-binding parameter-field
        parameter-reader)

(def parameter-binding
  (fn (parameter)
    (symbol (first parameter) (parameter-name parameter))))

(def parameter-field
  (fn (parameter)
    (list (symbol (first parameter)
                  (string ":" (parameter-name parameter)))
          (field-type parameter))))

(def parameter-reader
  (fn (parameter)
    (if (arg? parameter)
      (arg-reader parameter
                  (matches-name (first parameter))
                  (parameter-name parameter))
      (option-reader parameter
                     (matches-name (first parameter))
                     (parameter-name parameter)))))

(def arg-reader
  (fn (parameter found name)
    (choose (arg-kind parameter)
            (list kind-many
                  (template (read-args (unquote found)
                                       (unquote name)
                                       (unquote (reader-form parameter))))
                  kind-optional
                  (template (read-optional-arg (unquote found)
                                               (unquote name)
                                               (unquote (reader-form
                                                          parameter))))
                  kind-one
                  (template (read-arg (unquote found)
                                      (unquote name)
                                      (unquote (reader-form parameter))))))))

(def matches-name
  (fn (anchor) (symbol anchor "command-line-matches")))

(def field-type
  (fn (parameter)
    (if (arg? parameter)
      (parameter-type parameter)
      (option-field-type parameter (parameter-type parameter)))))

(def option-field-type
  (fn (parameter type)
    (choose (option-kind parameter)
            (list kind-switch
                  (quote switch-state)
                  kind-count
                  (quote int)
                  kind-many type kind-one
                  (one-field-type parameter type)))))

(def one-field-type
  (fn (parameter type)
    (if (always-set? parameter)
      type
      (template (option (unquote type))))))

(def option-reader
  (fn (parameter found name)
    (choose (option-kind parameter)
            (list kind-switch
                  (template (ok (read-switch (unquote found) (unquote name))))
                  kind-count
                  (template (ok (read-count (unquote found) (unquote name))))
                  kind-many
                  (template (read-many (unquote found)
                                       (unquote name)
                                       (unquote (reader-form parameter))))
                  kind-one
                  (one-reader parameter found name)))))

(def one-reader
  (fn (parameter found name)
    (if (always-set? parameter)
      (template (read-option (unquote found)
                             (unquote name)
                             (unquote (reader-form parameter))))
      (template (read-optional (unquote found)
                               (unquote name)
                               (unquote (reader-form parameter)))))))
