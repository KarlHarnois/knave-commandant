(module
  "Writes the spec of one `defcommand` parameter, and rejects the names every command already takes.")

(use code list symbol-name)

(use macros/parameters/kinds argument-kind choose kind-count
                             kind-many kind-one
                             kind-optional kind-switch
                             option-kind)

(use macros/parameters/parts argument? default-text
                             defaulted? detail given?
                             parameter-details
                             parameter-name parameter-type
                             required-parameter?
                             type-named?)

(use spec/shapes ->argument-spec ->list-slot ->option-spec
                 ->switch-slot ->value-slot
                 argument-presence option-presence
                 switch-state value-kind)

(use macros/parameters/names conflicts-form env-form)
(use values/convert value-names)
(use macros/parameters/details check-details)
(use macros/parameters/reserved check-reserved)

(export parameter-spec)

(def parameter-spec
  (fn (parameter)
    (if (argument? parameter)
      (argument-spec (check-details parameter))
      (option-spec (check-reserved (check-details parameter))))))

(def argument-spec
  (fn (parameter)
    (template (->argument-spec :name (str (unquote (parameter-name parameter)))
                               :about (str (unquote (about parameter)))
                               :presence (unquote (presence parameter))))))

(def presence
  (fn (parameter)
    (if (defaulted? parameter)
      (template (argument-presence/defaulted (str (unquote (default-text
                                                             parameter)))))
      (undefaulted-argument parameter))))

(def undefaulted-argument
  (fn (parameter)
    (choose (argument-kind parameter)
            (list kind-many
                  (repeated-presence parameter)
                  kind-optional
                  (quote argument-presence/optional)
                  kind-one
                  (quote argument-presence/required)))))

(def repeated-presence
  (fn (parameter)
    (if (required-parameter? parameter)
      (quote argument-presence/one-or-more)
      (quote argument-presence/zero-or-more))))

(def option-spec
  (fn (parameter)
    (template (->option-spec
                :long (str (unquote (parameter-name parameter)))
                :short (unquote (short-form parameter))
                :about (str (unquote (about parameter)))
                :value (unquote (value-form parameter
                                            (parameter-type parameter)))
                :conflicts-with (unquote (conflicts-form parameter))))))

(def about
  (fn (parameter)
    (if (given? (detail (parameter-details parameter) "about"))
      (detail (parameter-details parameter) "about")
      "")))

(def short-form
  (fn (parameter)
    (if (given? (detail (parameter-details parameter) "short"))
      (template (some (char (unquote (symbol-name (detail (parameter-details
                                                            parameter)
                                                          "short"))))))
      (quote none))))

(def value-form
  (fn (parameter type)
    (choose (option-kind parameter)
            (list kind-switch
                  (switch-form parameter)
                  kind-count
                  (quote value-kind/count)
                  kind-many
                  (list-form parameter)
                  kind-one
                  (one-form parameter type)))))

(def switch-form
  (fn (parameter)
    (template (value-kind/switch (->switch-slot
                                   :initial (unquote (initial-form parameter))
                                   :env (unquote (env-form parameter)))))))

(def list-form
  (fn (parameter)
    (template (value-kind/many (->list-slot :placeholder (str (unquote (parameter-name
                                                                         parameter)))
                                            :delimiter (unquote (delimiter-form parameter)))))))

(def one-form
  (fn (parameter type)
    (template (value-kind/one
                (->value-slot
                  :placeholder (str (unquote (parameter-name parameter)))
                  :presence (unquote (option-presence-form parameter))
                  :env (unquote (env-form parameter))
                  :choices (value-names (ref (the (option (unquote type))
                                                  none))))))))

(def delimiter-form
  (fn (parameter)
    (if (given? (detail (parameter-details parameter) "delimiter"))
      (template (some (char (unquote (detail (parameter-details parameter)
                                             "delimiter")))))
      (quote none))))

(def initial-form
  (fn (parameter)
    (if (type-named? (detail (parameter-details parameter) "initial")
                     "on")
      (quote switch-state/on)
      (quote switch-state/off))))

(def option-presence-form
  (fn (parameter)
    (if (defaulted? parameter)
      (template (option-presence/defaulted (str (unquote (default-text
                                                           parameter)))))
      (undefaulted-presence parameter))))

(def undefaulted-presence
  (fn (parameter)
    (if (required-parameter? parameter)
      (quote option-presence/required)
      (quote option-presence/optional))))
