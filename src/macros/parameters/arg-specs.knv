(module
  "Writes the spec of one `defcommand` argument.")

(use code list)

(use macros/parameters/kinds arg-kind choose kind-many
                             kind-one kind-optional)

(use macros/parameters/parts about default-text defaulted?
                             parameter-name
                             required-parameter?
                             value-name-form)

(use spec/shapes ->arg-spec presence repetition)
(use macros/parameters/readers names-form)

(export arg-spec)

(def arg-spec
  (fn (parameter)
    (template (->arg-spec :name (str (unquote (parameter-name parameter)))
                          :value-name (unquote (value-name-form parameter))
                          :choices (unquote (names-form parameter))
                          :about (str (unquote (about parameter)))
                          :presence (unquote (presence parameter))
                          :repeats (unquote (repeats parameter))))))

(def presence
  (fn (parameter)
    (if (defaulted? parameter)
      (template (presence/defaulted (str (unquote (default-text parameter)))))
      (undefaulted-arg parameter))))

(def undefaulted-arg
  (fn (parameter)
    (choose (arg-kind parameter)
            (list kind-many
                  (repeated-presence parameter)
                  kind-optional
                  (quote presence/optional)
                  kind-one
                  (quote presence/required)))))

(def repeated-presence
  (fn (parameter)
    (if (required-parameter? parameter)
      (quote presence/required)
      (quote presence/optional))))

(def repeats
  (fn (parameter)
    (choose (arg-kind parameter)
            (list kind-many
                  (quote repetition/repeated)
                  kind-optional
                  (quote repetition/once)
                  kind-one
                  (quote repetition/once)))))
