(module
  "Parses a command line into a value, or into an early exit: the text to print, the stream to print it on, the exit code and the reason for it.")

(use env env)

(use errors/cli-error ->usage-failure cli-error
                      usage-failure)

(use errors/report failure-report)
(use help/page spec->help)
(use help/terminal terminal-width)
(use parse outcome parse)
(use spec/commands spec-at)
(use spec/shapes command-spec)
(use spec/spec-error spec-error spec-error->message)
(use spec/validate validate-spec)
(use values/matches matches)

(export ->early-exit early-exit output-stream parse-line
        parse-line-into stop-reason)

(def success-code 0)

(def usage-code 2)

(def broken-spec-code 70)

(defstruct early-exit
  :text string
  :stream output-stream
  :code int
  :reason stop-reason)

(defenum stop-reason
  (help (vec string))
  (version string)
  completion
  (usage usage-failure)
  (broken-spec spec-error))

(defenum output-stream
  standard-output
  standard-error)

(defn parse-line (spec env words)
  (parse-line-into spec env words
    (fn (found) (ok (clone found)))))

(type parse-line-into
  (where (t)
    (fn ((ref command-spec)
         (ref env)
         (ref (vec string))
         (fn ((ref matches))
           (result t cli-error)))
      (result t early-exit))))

(defn parse-line-into (spec env words convert)
  (match (validate-spec spec)
    ((ok _) (parse-valid spec env words convert))
    ((err failure) (err (broken failure)))))

(type parse-valid
  (where (t)
    (fn ((ref command-spec)
         (ref env)
         (ref (vec string))
         (fn ((ref matches))
           (result t cli-error)))
      (result t early-exit))))

(defn parse-valid (spec env words convert)
  (match (parse spec env words)
    ((outcome/parsed found)
     (typed spec env (ref found) convert))
    ((outcome/help path)
     (err (answer (help-at spec (ref path) env)
                  (stop-reason/help path))))
    ((outcome/version text)
     (err (answer (str (:name spec) " " text)
                  (stop-reason/version text))))
    ((outcome/usage-error failure)
     (err (refusal spec env failure)))
    ((outcome/completion reply)
     (err (answer reply stop-reason/completion)))))

(type typed
  (where (t)
    (fn ((ref command-spec)
         (ref env)
         (ref matches)
         (fn ((ref matches))
           (result t cli-error)))
      (result t early-exit))))

(defn typed (spec env found convert)
  (map-err (convert found)
    (fn (failure)
      (refusal spec env
               (->usage-failure :path (clone (:path found)) :error failure)))))

(defn answer (text reason)
  (->early-exit :text text
                :stream output-stream/standard-output
                :code success-code
                :reason reason))

(defn refusal (spec env failure)
  (->early-exit :text (failure-report spec (ref failure) (terminal-width env))
                :stream output-stream/standard-error
                :code usage-code
                :reason (stop-reason/usage failure)))

(defn broken (failure)
  (->early-exit :text (str "invalid command spec: "
                           (spec-error->message (ref failure)))
                :stream output-stream/standard-error
                :code broken-spec-code
                :reason (stop-reason/broken-spec failure)))

(defn help-at (spec path env)
  (spec->help (ref (unwrap-or (spec-at spec path) (clone spec)))
              (terminal-width env)))
