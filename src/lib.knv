(module
  "Builds command line programs that follow the common conventions by default.")

(use environment ->environment ->variable environment
                 variable)

(use errors/report error-report failure-report)

(use errors/cli-error ->invalid-text ->option-conflict
                      ->usage-failure cli-error
                      error->message invalid-text
                      option-conflict usage-failure)

(use help/page spec->help spec->usage)

(use values/matches argument-text matched-value matches
                    option-value)

(use parse outcome parse parse-into)
(use macros/choice defchoice)
(use macros/cli defcli)
(use macros/command defcommand parse-command run-command)
(use run process-environment run run-with)
(use values/builtin)
(use values/convert cli-value from-text value-names)
(use spec/spec-error spec-error spec-error->message)
(use spec/validate validate-spec)

(use spec/shapes ->argument-spec ->command-spec ->list-slot
                 ->option-spec ->switch-slot ->value-slot
                 argument-presence argument-spec
                 command-spec list-slot option-presence
                 option-spec switch-slot switch-state
                 value-kind value-slot)

(export ->argument-spec ->command-spec ->environment
        ->invalid-text ->list-slot ->option-conflict
        ->option-spec ->switch-slot ->usage-failure
        ->value-slot ->variable argument-presence
        argument-spec argument-text cli-error cli-value
        command-spec defchoice defcli defcommand environment
        error->message error-report failure-report from-text
        invalid-text list-slot matched-value matches
        option-conflict option-presence option-spec
        option-value outcome parse parse-command parse-into
        process-environment run run-command run-with
        spec->help spec->usage spec-error
        spec-error->message switch-slot switch-state
        usage-failure validate-spec value-kind value-names
        value-slot variable)
