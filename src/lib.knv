(module
  "Builds command line programs that follow the common conventions by default.")

(use command-line ->early-exit early-exit output-stream
                  parse-line parse-line-into)

(use environment ->environment ->variable environment
                 variable)

(use errors/cli-error cli-error)
(use help/page spec->help spec->usage)

(use values/matches argument-text matched-value matches
                    option-value)

(use macros/choice defchoice)
(use macros/cli defcli)
(use macros/command defcommand parse-command run-command)
(use run exit-early process-environment run run-with)
(use values/builtin)
(use values/convert cli-value from-text value-names)
(use spec/spec-error spec-error spec-error->message)
(use spec/validate validate-spec)

(use spec/shapes ->argument-spec ->command-spec ->list-slot
                 ->option-spec ->switch-slot ->value-slot
                 argument-spec command-spec list-slot
                 option-spec presence repetition switch-slot
                 switch-state value-kind value-slot)

(export ->argument-spec ->command-spec ->early-exit
        ->environment ->list-slot ->option-spec
        ->switch-slot ->value-slot ->variable argument-spec
        argument-text cli-error cli-value command-spec
        defchoice defcli defcommand early-exit environment
        exit-early from-text list-slot matched-value matches
        option-spec option-value output-stream parse-command
        parse-line parse-line-into presence
        process-environment repetition run run-command
        run-with spec->help spec->usage spec-error
        spec-error->message switch-slot switch-state
        validate-spec value-kind value-names value-slot
        variable)
