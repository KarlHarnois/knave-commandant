(module
  "Builds command line programs that follow the common conventions by default.")

(use command-line ->early-exit early-exit output-stream
                  parse-line parse-line-into stop-reason)

(use environment ->environment ->variable environment
                 variable)

(use errors/cli-error ->invalid-text ->option-conflict
                      ->usage-failure cli-error
                      error->message invalid-text
                      option-conflict usage-failure)

(use help/page spec->help spec->usage)

(use values/matches arg-text matched-value matches
                    option-value)

(use macros/choice defchoice)
(use macros/cli defcli)
(use macros/command defcommand parse-args parse-args-from)
(use run exit-early process-environment run run-with)
(use spec/spec-error spec-error spec-error->message)
(use spec/validate validate-spec)

(use spec/shapes ->arg-spec ->command-spec ->list-slot
                 ->option-spec ->switch-slot ->value-slot
                 arg-spec command-spec list-slot option-spec
                 presence repetition switch-slot
                 switch-state value-kind value-slot)

(export ->arg-spec ->command-spec ->early-exit ->environment
        ->invalid-text ->list-slot ->option-conflict
        ->option-spec ->switch-slot ->usage-failure
        ->value-slot ->variable arg-spec arg-text cli-error
        command-spec defchoice defcli defcommand early-exit
        environment error->message exit-early invalid-text
        list-slot matched-value matches option-conflict
        option-spec option-value output-stream parse-args
        parse-args-from parse-line parse-line-into presence
        process-environment repetition run run-with
        spec->help spec->usage spec-error
        spec-error->message stop-reason switch-slot
        switch-state usage-failure validate-spec value-kind
        value-slot variable)
