(module
  "Builds command line programs that follow the common conventions by default.")

(use environment ->environment ->variable environment
                 variable)

(use error-report error-report)

(use errors ->invalid-text cli-error error->message
            invalid-text)

(use help spec->help spec->usage)

(use matches argument-text matched-value matches
             option-value)

(use parse outcome parse)
(use macros/choice defchoice)
(use macros/command defcommand)
(use run run run-with)
(use values cli-value from-text value-names)
(use validate spec-error spec-error->message validate-spec)

(use spec ->argument-spec ->command-spec ->option-spec
          ->switch-slot ->value-slot argument-presence
          argument-spec command-spec option-spec switch-slot
          switch-state value-kind value-slot)

(export ->argument-spec ->command-spec ->environment
        ->invalid-text ->option-spec ->switch-slot
        ->value-slot ->variable argument-presence
        argument-spec argument-text cli-error cli-value
        command-spec defchoice defcommand environment
        error->message error-report from-text invalid-text
        matched-value matches option-spec option-value
        outcome parse run run-with spec->help spec->usage
        spec-error spec-error->message switch-slot
        switch-state validate-spec value-kind value-names
        value-slot variable)
