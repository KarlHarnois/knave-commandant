(module
  "Builds command line programs that follow the common conventions by default.")

(use environment ->environment ->variable environment
                 variable)

(use error-report error-report failure-report)

(use errors ->invalid-text ->usage-failure cli-error
            error->message invalid-text usage-failure)

(use help spec->help spec->usage)

(use matches argument-text matched-value matches
             option-value)

(use parse outcome parse parse-into)
(use macros/choice defchoice)
(use macros/cli defcli)
(use macros/command defcommand parse-command run-command)
(use run process-environment run run-with)
(use values cli-value from-text value-names)
(use validate spec-error spec-error->message validate-spec)

(use spec ->argument-spec ->command-spec ->option-spec
          ->switch-slot ->value-slot argument-presence
          argument-spec command-spec option-presence
          option-spec switch-slot switch-state value-kind
          value-slot)

(export ->argument-spec ->command-spec ->environment
        ->invalid-text ->option-spec ->switch-slot
        ->usage-failure ->value-slot ->variable
        argument-presence argument-spec argument-text
        cli-error cli-value command-spec defchoice defcli
        defcommand environment error->message error-report
        failure-report from-text invalid-text matched-value
        matches option-presence option-spec option-value
        outcome parse parse-command parse-into
        process-environment run run-command run-with
        spec->help spec->usage spec-error
        spec-error->message switch-slot switch-state
        usage-failure validate-spec value-kind value-names
        value-slot variable)
