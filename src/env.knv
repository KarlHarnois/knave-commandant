(module
  "Holds the environment variables a parse reads, so parsing stays a pure function.")

(export ->env ->variable env first-set variable)

(defstruct env
  :variables (vec variable))

(defstruct variable
  :name string
  :value string)

(defn first-set (env names)
  (then-some (find (iter names)
               (fn (name)
                 (some? (variable-value env name))))
             (fn (name) (variable-value env name))))

(defn variable-value (env name)
  (map-some (find (iter (:variables env))
              (fn (variable)
                (= (as-str (:name variable))
                   (as-str name))))
            (fn (variable)
              (clone (:value variable)))))
