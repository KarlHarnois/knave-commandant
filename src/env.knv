(module
  "Holds the environment variables a parse reads, so parsing stays a pure function.")

(export ->env ->env-var env env-var first-set)

(defstruct env
  :vars (vec env-var))

(defstruct env-var
  :name string
  :value string)

(defn first-set (env names)
  (then-some (find (iter names)
               (fn (name)
                 (some? (env-var-value env name))))
             (fn (name) (env-var-value env name))))

(defn env-var-value (env name)
  (map-some (find (iter (:vars env))
              (fn (env-var)
                (= (as-str (:name env-var))
                   (as-str name))))
            (fn (env-var) (clone (:value env-var)))))
