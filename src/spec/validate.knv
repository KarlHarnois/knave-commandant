(module
  "Runs every check on a command's spec and on the spec of each command under it, before a parse hides a mistake.")

(use spec/checks mistakes)
(use spec/commands descended)

(export validate-spec)

(defn validate-spec (spec)
  (match (first (mistakes spec))
    ((some mistake) (err (clone mistake)))
    (none (validate-subcommands spec))))

(defn validate-subcommands (spec)
  (reduce (iter (:subcommands spec)) (ok (do))
    (fn (so-far subcommand)
      (then-ok so-far
        (fn (_)
          (validate-spec (ref (descended spec subcommand))))))))
