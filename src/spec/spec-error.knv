(module
  "Names each mistake a spec can hold, and says it in a sentence.")

(use spec/arg-order order-error order-error->message)
(use spec/builtins help-command)

(export spec-error spec-error->message)

(defenum spec-error
  (reserved-long string)
  (reserved-short char)
  (repeated-long string)
  (repeated-short char)
  (repeated-arg string)
  (misordered-arg order-error)
  (unknown-conflict string)
  reserved-command
  (repeated-command string))

(defn spec-error->message (failure)
  (match failure
    ((reserved-long name)
     (str "option `--" name
          "` is built in, so a spec cannot define it"))
    ((reserved-short name)
     (str "option `-" name
          "` is built in, so a spec cannot define it"))
    ((repeated-long name)
     (str "two options are named `--" name "`"))
    ((repeated-short name)
     (str "two options are named `-" name "`"))
    ((repeated-arg name)
     (str "two arguments are named <" name ">"))
    ((misordered-arg failure) (order-error->message failure))
    ((unknown-conflict name)
     (str "an option conflicts with `--" name
          "`, which is not an option"))
    (reserved-command (str "command `" help-command
                           "` is built in, so a spec cannot define it"))
    ((repeated-command name)
     (str "two commands are named `" name "`"))))
