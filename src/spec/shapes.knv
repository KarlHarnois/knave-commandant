(module
  "Describes a command: its arguments, its options, and how each option takes a value.")

(export ->argument-spec ->command-spec ->list-slot
        ->option-spec ->switch-slot ->value-slot
        argument-label argument-spec command-spec find-long
        find-short list-slot long-flag long-names
        long-prefix name->placeholder option-required?
        option-spec presence repeated? repetition required?
        short-takes-value? switch-slot switch-state switch?
        takes-value? value-kind value-slot)

(defstruct command-spec
  :name string
  :about string
  :version (option string)
  :arguments (vec argument-spec)
  :options (vec option-spec)
  :subcommands (vec command-spec))

(defstruct argument-spec
  :name string
  :value-name (option string)
  :choices (vec string)
  :about string
  :presence presence
  :repeats repetition)

(defenum presence
  required
  optional
  (defaulted string))

(defenum repetition
  once
  repeated)

(defstruct option-spec
  :long string
  :short (option char)
  :about string
  :value value-kind
  :conflicts-with (vec string))

(defenum value-kind
  (switch switch-slot)
  count
  (one value-slot)
  (many list-slot))

(defstruct list-slot
  :placeholder string
  :delimiter (option char))

(defstruct switch-slot
  :initial switch-state
  :env (vec string))

(defenum switch-state
  off
  on)

(defstruct value-slot
  :value-name (option string)
  :presence presence
  :env (vec string)
  :choices (vec string))

(defn name->placeholder (name)
  (upper-case (as-str (join (collect (split name "-")) "_"))))

(def long-prefix "--")

(defn long-flag (long) (str long-prefix long))

(type argument-label
  (fn ((ref argument-spec)) string))

(defn argument-label (argument)
  (unwrap-or (clone (:value-name argument))
             (clone (:name argument))))

(defn long-names (spec)
  (collect (map (iter (:options spec))
             (fn (option) (clone (:long option))))))

(defn find-long (spec name)
  (find (iter (:options spec))
    (fn (option)
      (= (as-str (:long option)) name))))

(defn short-takes-value? (spec character)
  (match (find-short spec character)
    ((some option) (takes-value? option))
    (none false)))

(defn find-short (spec character)
  (find (iter (:options spec))
    (fn (option)
      (= (:short option) (some character)))))

(defn takes-value? (option)
  (match (:value option)
    ((one _) true)
    ((many _) true)
    (_ false)))

(defn switch? (option)
  (match (:value option)
    ((switch _) true)
    (_ false)))

(defn option-required? (option)
  (match (:value option)
    ((one slot) (presence-required? (:presence slot)))
    (_ false)))

(type required?
  (fn ((ref argument-spec)) bool))

(defn required? (argument)
  (presence-required? (:presence argument)))

(defn repeated? (argument)
  (= (:repeats argument) repetition/repeated))

(defn presence-required? (presence)
  (match presence (required true) (_ false)))
