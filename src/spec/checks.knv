(module
  "Runs each check a command's spec must pass and lists the mistakes they find.")

(use resolve/conflicts unknown-conflict)
(use spec/arg-order arg-order)
(use spec/builtins builtin-options help-command)
(use spec/commands subcommand-names)
(use spec/shapes long-names)
(use spec/spec-error spec-error)

(export mistakes)

(defn mistakes (spec)
  (let (found (vec))
    (for-each (iter (vec (check-longs spec)
                         (check-shorts spec)
                         (check-conflict-names spec)
                         (check-args spec)
                         (check-arg-order spec)
                         (check-commands spec)))
              (fn (finding)
                (push-mistake! (mut found) finding)))
    found))

(defn push-mistake! (found finding)
  (match finding
    ((err failure) (push! found (clone failure)))
    ((ok _) (do))))

(defn check-arg-order (spec)
  (map-err (arg-order spec)
    (fn (failure) (spec-error/misordered-arg failure))))

(defn check-conflict-names (spec)
  (match (unknown-conflict spec)
    ((some name) (err (spec-error/unknown-conflict name)))
    (none (ok (do)))))

(defn check-commands (spec)
  (commands-checked (subcommand-names spec)))

(defn commands-checked (names)
  (if (any? (iter names)
        (fn (name)
          (= (as-str name) help-command)))
    (err spec-error/reserved-command)
    (map-err (check-unique (ref names))
      (fn (name) (spec-error/repeated-command name)))))

(defn short-names (spec)
  (let (shorts (vec))
    (for-each (iter (:options spec))
      (fn (option)
        (push-short! (mut shorts) option)))
    shorts))

(defn push-short! (shorts option)
  (match (:short option)
    ((some character) (push! shorts character))
    (none (do))))

(defn arg-names (spec)
  (collect (map (iter (:args spec))
             (fn (arg) (clone (:name arg))))))

(defn check-longs (spec)
  (longs-checked (long-names spec)))

(defn longs-checked (names)
  (match (find (iter names)
           (fn (name)
             (reserved-long? (as-str name))))
    ((some name) (err (spec-error/reserved-long (clone name))))
    (none (map-err (check-unique (ref names))
            (fn (name) (spec-error/repeated-long name))))))

(defn reserved-long? (name)
  (any? (builtin-options)
    (fn (builtin)
      (= (as-str (:name builtin)) name))))

(defn reserved-short? (character)
  (any? (builtin-options)
    (fn (builtin)
      (= (:letter builtin) character))))

(defn check-shorts (spec)
  (shorts-checked (short-names spec)))

(defn shorts-checked (names)
  (match (find (iter names)
           (fn (name)
             (reserved-short? (deref (deref name)))))
    ((some name) (err (spec-error/reserved-short (deref name))))
    (none (map-err (check-unique (ref names))
            (fn (name) (spec-error/repeated-short name))))))

(defn check-args (spec)
  (map-err (check-unique (ref (arg-names spec)))
    (fn (name) (spec-error/repeated-arg name))))

(defn check-unique (names)
  (match (find (range 1 (len names))
           (fn (index)
             (seen-before? names (deref index))))
    ((some index) (err (clone (at names index))))
    (none (ok (do)))))

(defn seen-before? (names index)
  (any? (range 0 index)
    (fn (earlier)
      (= (at names earlier) (at names index)))))
