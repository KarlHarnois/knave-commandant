(module
  "Checks that a command's arguments come in an order a command line can fill: required ones first, at most one repeated argument, and only required ones after it.")

(use spec/shapes presence repeated? required?)

(export arg-order order-error order-error->message)

(defenum order-error
  (second-repeated string)
  (after-optional string)
  (after-repeated string)
  (repeated-default string))

(defn arg-order (spec) (order-from spec 0))

(defn order-error->message (failure)
  (match failure
    ((second-repeated name)
     (str "argument <" name
          "> repeats, but only one argument can"))
    ((after-optional name)
     (str "argument <" name
          "> must come before every optional argument"))
    ((after-repeated name)
     (str "argument <" name
          "> follows a repeated argument, so it must be required"))
    ((repeated-default name)
     (str "argument <" name
          "> repeats, so it cannot have a default"))))

(defn order-from (spec index)
  (if (>= index (len (:args spec)))
    (ok (do))
    (order-at spec index)))

(defn order-at (spec index)
  (match (violation-at spec index)
    ((some failure) (err failure))
    (none (order-from spec (inc index)))))

(defn violation-at (spec index)
  (let (arg (at (:args spec) index)
        name (clone (:name arg)))
    (cond
      ((and (repeated? arg) (defaulted? arg))
       (some (order-error/repeated-default name)))
      ((and (repeated? arg) (earlier? spec index repeated?))
       (some (order-error/second-repeated name)))
      ((and (must-be-given? arg) (earlier? spec index optional?))
       (some (order-error/after-optional name)))
      ((and (earlier? spec index repeated?)
            (not (single-required? arg)))
       (some (order-error/after-repeated name)))
      (else none))))

(defn earlier? (spec index test)
  (any? (range 0 index)
    (fn (earlier)
      (test (at (:args spec) earlier)))))

(defn must-be-given? (arg)
  (or (required? arg) (repeated? arg)))

(defn defaulted? (arg)
  (match (:presence arg)
    ((defaulted _) true)
    (_ false)))

(defn optional? (arg)
  (not (or (required? arg) (repeated? arg))))

(defn single-required? (arg)
  (and (required? arg)
       (not (repeated? arg))))
