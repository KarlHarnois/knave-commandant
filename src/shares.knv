(module
  "Works out which words of a command line each argument takes: one each, except a repeated argument, which takes every word the arguments after it leave.")

(use spec command-spec repeated?)

(export share shares-of split split-of taken-total)

(defstruct share
  :start int
  :count int)

(defstruct split
  :leading int
  :leading-taken int
  :repeated-taken int
  :trailing-taken int)

(type split-of
  (fn ((ref command-spec) int) split))

(defn split-of (spec given)
  (let (repeated-index (find (range 0 (len (:arguments spec)))
                         (fn (index)
                           (repeated? (at (:arguments spec) index))))
        leading (unwrap-or repeated-index (len (:arguments spec)))
        trailing (- (len (:arguments spec))
                    leading
                    (repeated-count repeated-index))
        leading-taken (min leading given)
        trailing-taken (min trailing (- given leading-taken)))
    (->split :leading leading
             :leading-taken leading-taken
             :repeated-taken (* (repeated-count repeated-index)
                                (- given leading-taken trailing-taken))
             :trailing-taken trailing-taken)))

(defn repeated-count (repeated-index)
  (match repeated-index
    ((some _) 1)
    (none 0)))

(type shares-of
  (fn ((ref command-spec) (ref split))
    (vec share)))

(defn shares-of (spec layout)
  (collect (map (range 0 (len (:arguments spec)))
             (fn (index) (share-at layout index)))))

(type share-at
  (fn ((ref split) int) share))

(defn share-at (layout index)
  (cond
    ((< index (:leading layout)) (leading-share layout index))
    ((= index (:leading layout))
     (->share :start (:leading-taken layout)
              :count (:repeated-taken layout)))
    (else (trailing-share layout (- index (:leading layout) 1)))))

(defn leading-share (layout index)
  (->share :start index
           :count (taken-count (< index (:leading-taken layout)))))

(defn trailing-share (layout offset)
  (->share :start (+ (:leading-taken layout) (:repeated-taken layout) offset)
           :count (taken-count (< offset (:trailing-taken layout)))))

(defn taken-count (taken?) (if taken? 1 0))

(defn taken-total (layout)
  (+ (:leading-taken layout)
     (:repeated-taken layout)
     (:trailing-taken layout)))
