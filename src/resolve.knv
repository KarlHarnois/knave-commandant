(module
  "Turns a scan into matches: fills each argument, checks that a single-value option is given once, and settles each option.")

(use arguments resolve-arguments)
(use errors cli-error)
(use matches ->matches)
(use scan-state occurrence)
(use settle occurrences-of option-matches)
(use spec command-spec option-spec value-kind)

(export resolve)

(defn resolve (spec environment scan)
  (let-try (arguments (resolve-arguments spec (ref (:positionals scan))))
    (try (check-no-repeated spec (ref (:occurrences scan))))
    (ok (->matches :path (clone (:path scan))
                   :arguments arguments
                   :options (option-matches spec environment
                                            (ref (:occurrences scan)))))))

(type check-no-repeated
  (fn ((ref command-spec)
       (ref (vec occurrence)))
    (result unit cli-error)))

(defn check-no-repeated (spec occurrences)
  (match (find (iter (:options spec))
           (fn (option) (repeated? option occurrences)))
    ((some option)
     (err (cli-error/repeated-option (second-written option occurrences))))
    (none (ok (do)))))

(defn repeated? (option occurrences)
  (and (single-value? option)
       (> (len (occurrences-of option occurrences)) 1)))

(type single-value?
  (fn ((ref option-spec)) bool))

(defn single-value? (option)
  (match (:value option)
    ((one _) true)
    (_ false)))

(defn second-written (option occurrences)
  (clone (:written (at (occurrences-of option occurrences) 1))))
